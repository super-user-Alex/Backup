"""
mover_pdf_directo.py
====================
Mueve elementos de un PDF de Illustrator manipulando el content stream
directamente. Sin conversión a SVG ni rasterización.

Cómo funciona internamente:
    Un PDF tiene un "content stream" con operadores gráficos. Los OCGs
    están envueltos en marcadores BDC/EMC:

        /OC /NombreCapa BDC    ← inicio del OCG
            ... elementos ...
        EMC                    ← fin del OCG

    Para mover esos elementos, se inserta el operador `cm`
    (concatenate matrix) antes del BDC, que aplica una transformación
    al sistema de coordenadas — exactamente como el translate de Illustrator.

    El operador cm recibe 6 valores (matriz afín):
        a b c d e f cm
        Para una traslación pura: 1 0 0 1 dx dy cm

Dependencias:
    pip install pikepdf pymupdf
"""

import re
import fitz    # PyMuPDF  — solo para listar/inspeccionar OCGs
import pikepdf
from pikepdf import Pdf, Page, parse_content_stream, unparse_content_stream, ContentStreamInstruction, Operator

# ─────────────────────────────────────────────────────────────
# 1. INSPECCIÓN — listar OCGs (usa PyMuPDF, solo lectura)
# ─────────────────────────────────────────────────────────────

def listar_ocgs(pdf_path: str) -> dict:
    """
    Lista los OCGs (capas) del PDF con su nombre y estado.

    Returns:
        {nombre: xref_id}
    """
    doc = fitz.open(pdf_path)
    ocgs = doc.get_ocgs()

    if not ocgs:
        print("⚠️  El PDF no tiene OCGs.")
        return {}

    print(f"\n{'═' * 50}")
    print(f"  PDF: {pdf_path}")
    print(f"  OCGs encontrados: {len(ocgs)}")
    print(f"{'═' * 50}")
    resultado = {}
    for xref, info in ocgs.items():
        estado = "🟢 visible" if info['on'] else "🔴 oculto"
        print(f"  ID {xref:4d} | {estado:12s} | {info['name']}")
        resultado[info['name']] = xref
    print()
    return resultado


def analizar_ocgs_en_stream(pdf_path: str):
    """
    Inspecciona el content stream del PDF y muestra los OCGs
    encontrados con sus operadores internos.
    Útil para entender cómo están estructurados los elementos.
    """
    pdf = Pdf.open(pdf_path)
    page = pdf.pages[0]

    raw = b"".join(page.obj.get("/Contents").read_bytes()
                   if hasattr(page.obj.get("/Contents"), "read_bytes")
                   else [page.obj["/Contents"].read_bytes()])

    # Buscar todos los marcadores BDC con /OC
    patron = rb'/OC\s+/(\w+)\s+BDC'
    ocgs_en_stream = re.findall(patron, raw)

    print(f"\n{'═' * 50}")
    print("  OCGs detectados en el content stream:")
    print(f"{'═' * 50}")
    for nombre in set(ocgs_en_stream):
        conteo = ocgs_en_stream.count(nombre)
        print(f"  → /{nombre.decode()} ({conteo} bloque{'s' if conteo > 1 else ''})")
    print()

    pdf.close()
    return [n.decode() for n in set(ocgs_en_stream)]


# ─────────────────────────────────────────────────────────────
# 2. MANIPULACIÓN DIRECTA DEL CONTENT STREAM
# ─────────────────────────────────────────────────────────────

def _traducir_bytes_stream(stream_bytes: bytes, nombre_ocg: str,
                           dx: float, dy: float) -> bytes:
    """
    Inserta `1 0 0 1 dx dy cm` antes de cada bloque BDC del OCG
    y restaura con `1 0 0 -dy -dx cm` al cerrar con EMC.

    En PDF, `cm` modifica el Current Transformation Matrix (CTM),
    equivalente al translate() de Illustrator sobre el grupo.

    Args:
        stream_bytes: Content stream raw del PDF.
        nombre_ocg  : Nombre del OCG a mover (como aparece en el stream).
        dx, dy      : Desplazamiento en puntos PDF (1pt = 1/72 inch).

    Returns:
        Content stream modificado como bytes.
    """
    # Convertir dy para el sistema de coordenadas PDF
    # PDF tiene Y invertido respecto a Illustrator: arriba es mayor
    nombre_encoded = nombre_ocg.encode()

    # Patrón: /OC /NombreOCG BDC
    patron_bdc = re.compile(
        rb'(/OC\s+/' + re.escape(nombre_encoded) + rb'\s+BDC)'
    )
    patron_emc = re.compile(rb'(EMC)')

    # Operador de traslación PDF: a b c d e f cm
    # Traslación pura = 1 0 0 1 dx dy cm
    translate_in  = f'\nq\n1 0 0 1 {dx} {dy} cm\n'.encode()
    translate_out = b'\nQ\n'  # q/Q guardan y restauran el estado gráfico

    # Estrategia: envolver cada bloque BDC...EMC con q ... cm ... Q
    # Para hacerlo correctamente necesitamos rastrear la profundidad BDC/EMC

    resultado = []
    pos = 0
    profundidad_ocg = 0  # rastrear bloques OCG anidados
    profundidad_q = 0    # rastrear q/Q para balance

    i = 0
    lineas = stream_bytes.split(b'\n')
    output_lineas = []

    for linea in lineas:
        linea_stripped = linea.strip()

        # Detectar inicio del OCG objetivo
        if patron_bdc.search(linea_stripped):
            output_lineas.append(translate_in)
            output_lineas.append(linea)
            profundidad_ocg += 1

        # Detectar cierre de un bloque marcado
        elif linea_stripped == b'EMC' and profundidad_ocg > 0:
            output_lineas.append(linea)
            output_lineas.append(translate_out)
            profundidad_ocg -= 1

        else:
            output_lineas.append(linea)

    return b'\n'.join(output_lineas)


def mover_ocg_directo(pdf_path: str, nombre_ocg: str,
                      dx: float, dy: float,
                      output_pdf: str = 'resultado.pdf'):
    """
    Mueve un OCG completo dentro del PDF modificando el content stream.
    El resultado es un PDF válido, sin pasar por SVG ni rasterizar.

    Args:
        pdf_path   : Ruta al PDF de Illustrator (con OCGs).
        nombre_ocg : Nombre exacto del OCG a mover (ver listar_ocgs()).
        dx         : Desplazamiento horizontal en puntos PDF.
        dy         : Desplazamiento vertical en puntos PDF.
                     ⚠️  En PDF el eje Y va de abajo hacia arriba:
                         dy positivo = mover hacia arriba
                         dy negativo = mover hacia abajo
        output_pdf : Ruta del PDF resultante.

    Returns:
        Ruta del PDF guardado.

    Ejemplo:
        # Mover el OCG "Logo" 100pts a la derecha y 50pts hacia abajo
        mover_ocg_directo('diseño.pdf', 'Logo', dx=100, dy=-50)
    """
    pdf = Pdf.open(pdf_path)

    for i, page in enumerate(pdf.pages):
        contenido = page.obj.get("/Contents")
        if contenido is None:
            continue

        # Leer el stream (puede ser un objeto o un array de objetos)
        if isinstance(contenido, pikepdf.Array):
            # Múltiples streams en la página — procesar cada uno
            for stream_obj in contenido:
                _modificar_stream_objeto(stream_obj, nombre_ocg, dx, dy)
        else:
            _modificar_stream_objeto(contenido, nombre_ocg, dx, dy)

        print(f"  Página {i+1}: OCG '{nombre_ocg}' procesado")

    pdf.save(output_pdf)
    print(f"\n✓ PDF guardado en: {output_pdf}")
    print(f"  (sin conversión a SVG ni rasterización)")
    pdf.close()
    return output_pdf


def _modificar_stream_objeto(stream_obj, nombre_ocg: str,
                              dx: float, dy: float):
    """Modifica el content stream de un objeto pikepdf."""
    try:
        raw = stream_obj.read_bytes()
        modificado = _traducir_bytes_stream(raw, nombre_ocg, dx, dy)
        stream_obj.write(modificado)
    except Exception as e:
        print(f"  ⚠️  No se pudo modificar el stream: {e}")


# ─────────────────────────────────────────────────────────────
# 3. MOVER A POSICIÓN ABSOLUTA
# ─────────────────────────────────────────────────────────────

def mover_ocg_a_posicion(pdf_path: str, nombre_ocg: str,
                          nuevo_x: float, nuevo_y: float,
                          output_pdf: str = 'resultado.pdf') -> str:
    """
    Mueve un OCG a una posición absoluta del canvas.
    Calcula automáticamente el dx/dy desde la posición actual.

    Args:
        pdf_path   : Ruta al PDF.
        nombre_ocg : Nombre del OCG.
        nuevo_x    : Nueva posición X absoluta (pts desde borde izquierdo).
        nuevo_y    : Nueva posición Y absoluta (pts desde borde inferior).
        output_pdf : PDF resultante.
    """
    # Obtener posición actual del OCG con PyMuPDF
    doc = fitz.open(pdf_path)
    ocgs = doc.get_ocgs()
    page = doc[0]

    ocg_xref = None
    for xref, info in ocgs.items():
        if info['name'].lower() == nombre_ocg.lower():
            ocg_xref = xref
            break

    if ocg_xref is None:
        raise ValueError(f"OCG '{nombre_ocg}' no encontrado.")

    # Aislar el OCG para medir su bounding box actual
    for xref in ocgs:
        doc.set_ocg(xref, False)
    doc.set_ocg(ocg_xref, True)

    paths = page.get_drawings()
    if not paths:
        raise ValueError(f"OCG '{nombre_ocg}' no tiene elementos medibles.")

    # Bounding box en coordenadas PyMuPDF (Y desde arriba)
    x0 = min(p['rect'].x0 for p in paths)
    y0 = min(p['rect'].y0 for p in paths)

    # Convertir Y de PyMuPDF (top-down) a PDF (bottom-up)
    altura_pagina = page.rect.height
    y0_pdf = altura_pagina - y0

    dx = nuevo_x - x0
    # Y va invertido entre PyMuPDF y PDF nativo
    dy = -(nuevo_y - y0_pdf)

    # Restaurar OCGs
    for xref, info in ocgs.items():
        doc.set_ocg(xref, info['on'])
    doc.close()

    print(f"\n  Posición actual : ({x0:.1f}, {y0_pdf:.1f}) pts")
    print(f"  Posición destino: ({nuevo_x:.1f}, {nuevo_y:.1f}) pts")
    print(f"  Desplazamiento  : dx={dx:.1f}, dy={dy:.1f}")

    return mover_ocg_directo(pdf_path, nombre_ocg, dx, dy, output_pdf)


# ─────────────────────────────────────────────────────────────
# 4. VERIFICAR RESULTADO (sin rasterizar — solo metadatos)
# ─────────────────────────────────────────────────────────────

def verificar_posicion_ocg(pdf_path: str, nombre_ocg: str):
    """
    Verifica la posición actual del OCG en el PDF usando PyMuPDF.
    No rasteriza — usa get_drawings() que lee los vectores nativos.
    """
    doc = fitz.open(pdf_path)
    ocgs = doc.get_ocgs()
    page = doc[0]

    ocg_xref = None
    for xref, info in ocgs.items():
        if info['name'].lower() == nombre_ocg.lower():
            ocg_xref = xref
            break

    if ocg_xref is None:
        print(f"⚠️  OCG '{nombre_ocg}' no encontrado en: {pdf_path}")
        return

    for xref in ocgs:
        doc.set_ocg(xref, False)
    doc.set_ocg(ocg_xref, True)

    paths = page.get_drawings()

    print(f"\n  Verificación de '{nombre_ocg}' en {pdf_path}:")
    if paths:
        x0 = min(p['rect'].x0 for p in paths)
        y0 = min(p['rect'].y0 for p in paths)
        x1 = max(p['rect'].x1 for p in paths)
        y1 = max(p['rect'].y1 for p in paths)
        print(f"  BBox : ({x0:.1f}, {y0:.1f}, {x1:.1f}, {y1:.1f})")
        print(f"  Tamaño: {x1-x0:.1f} x {y1-y0:.1f} pts")
    else:
        print("  Sin elementos detectables.")

    for xref, info in ocgs.items():
        doc.set_ocg(xref, info['on'])
    doc.close()



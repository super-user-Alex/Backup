import pymupdf
import re

def get_swatches(doc):
    """Extrae swatches Separation del PDF: {nombre: (c, m, y, k)}"""
    swatches = {}
    for xref in range(1, doc.xref_length()):
        try:
            obj_str = doc.xref_object(xref, compressed=False)
        except:
            continue
        if "/Separation" not in obj_str:
            continue
        
        match_name = re.search(r'/Separation\s+/([^\s/\]>]+)', obj_str)
        # Extraer C1 (color al 100%) — 4 valores CMYK
        match_c1 = re.search(r'/C1\s*\[([^\]]+)\]', obj_str)
        
        if match_name and match_c1:
            name = match_name.group(1)
            c1_values = [float(v) for v in match_c1.group(1).split()]
            swatches[name] = tuple(c1_values)  # (C, M, Y, K)
    
    return swatches


def add_separation_colorspace(doc, name, cmyk):
    """
    Inserta un colorspace Separation en el PDF con nombre y valores CMYK.
    Retorna el xref del colorspace creado.
    """
    c, m, y, k = cmyk
    cs_obj = f"""[ /Separation /{name} /DeviceCMYK <<
    /FunctionType 2
    /Domain [ 0 1 ]
    /C0 [ 0 0 0 0 ]
    /C1 [ {c} {m} {y} {k} ]
    /N 1
    /Range [ 0 1 0 1 0 1 0 1 ]
>>]"""
    xref = doc.get_new_xref()
    doc.update_object(xref, cs_obj)
    return xref


def draw_with_swatch(page, rect, swatch_name, cmyk, doc):
    """
    Dibuja un rectángulo usando el colorspace Separation del swatch,
    de modo que Illustrator reconozca el nombre del color.
    """
    # Crear el colorspace Separation en el PDF
    cs_xref = add_separation_colorspace(doc, swatch_name, cmyk)

    # Registrar el colorspace como recurso de la página
    # Nombre interno del recurso (sin espacios)
    cs_resource_name = f"CS_{swatch_name.replace(' ', '_')}"
    
    # Obtener recursos actuales de la página
    page_obj = doc.xref_object(page.xref, compressed=False)
    
    # Insertar el colorspace en /Resources /ColorSpace
    doc.set_page_label  # solo para asegurar que la página está inicializada
    page._set_resource_property(
        "ColorSpace", cs_resource_name, f"{cs_xref} 0 R"
    )

    # Dibujar con content stream usando el colorspace Separation
    # Tint = 1.0 significa 100% del color
    tint = 1.0
    x0, y0, x1, y1 = rect.x0, rect.y0, rect.x1, rect.y1
    # Convertir coordenadas a espacio PDF (origen abajo)
    h = page.rect.height
    
    stream = f"""q
/{cs_resource_name} CS        % colorspace de relleno
{tint} SCN                    % tint al 100%
/{cs_resource_name} cs        % colorspace de trazo
{tint} scn
{x0} {h - y1} {x1 - x0} {y1 - y0} re
f
Q
"""
    page.insert_text((0, 0), "", overlay=False)  # asegurar que page tiene contents
    # Inyectar el stream directamente
    doc.update_stream(page.get_contents()[-1], stream.encode(), new=False)


# ── USO ──────────────────────────────────────────────────────────────────────

doc = pymupdf.open("tu_archivo.pdf")

# 1. Extraer swatches del PDF
swatches = get_swatches(doc)
print("Swatches encontrados:", swatches)
# → {'LASER': (0.0, 0.0, 0.0, 0.7), ...}

# 2. Dibujar usando el swatch por nombre
page = doc[0]
nombre = "LASER"
cmyk = swatches[nombre]  # (0.0, 0.0, 0.0, 0.7)

draw_with_swatch(
    page=page,
    rect=pymupdf.Rect(50, 50, 200, 150),
    swatch_name=nombre,
    cmyk=cmyk,
    doc=doc
)

doc.save("output.pdf")

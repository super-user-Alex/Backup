"""
ocg_to_pages_pypdf.py
---------------------
Extrae cada Optional Content Group (OCG / capa) de un PDF
y genera una página separada por cada uno.

Requiere solo pypdf:
    pip install pypdf

Uso:
    python ocg_to_pages_pypdf.py input.pdf output.pdf
    python ocg_to_pages_pypdf.py input.pdf output.pdf --no-common --verbose
"""

import sys
import io
import zlib
import argparse

from pypdf import PdfReader, PdfWriter
from pypdf.generic import (
    ContentStream, NameObject, IndirectObject,
    EncodedStreamObject,
)


# ---------------------------------------------------------------------------
# OCG helpers
# ---------------------------------------------------------------------------

def get_ocgs(reader: PdfReader) -> list[dict]:
    """Retorna [{'name': str, 'idnum': int}, ...] con los OCGs del catálogo."""
    root = reader.trailer['/Root']
    if '/OCProperties' not in root:
        return []
    return [
        {'name': str(ref.get_object()['/Name']), 'idnum': ref.idnum}
        for ref in root['/OCProperties']['/OCGs']
    ]


def get_prop_map(page) -> dict:
    """Devuelve { '/PropName': 'OCG Name' } desde Resources/Properties."""
    prop_map = {}
    try:
        for key, obj in page['/Resources']['/Properties'].items():
            if isinstance(obj, IndirectObject):
                obj = obj.get_object()
            if obj.get('/Type') == NameObject('/OCG'):
                prop_map[key] = str(obj['/Name'])
    except (KeyError, AttributeError):
        pass
    return prop_map


# ---------------------------------------------------------------------------
# Content stream filtering
# ---------------------------------------------------------------------------

def _visible(stack: list, target: str, include_common: bool) -> bool:
    if not stack:
        return include_common
    for frame in reversed(stack):
        if frame[0] == 'oc':
            return frame[1] == target
    return include_common


def filter_ops(ops: list, prop_map: dict,
               target_name: str, include_common: bool) -> list:
    """
    Retiene solo las instrucciones del bloque OC de `target_name`
    y, opcionalmente, el contenido fuera de cualquier capa.
    """
    result, stack = [], []

    for operands, operator in ops:
        op = operator if isinstance(operator, str) else operator.decode()

        if op in ('BDC', 'BMC'):
            is_oc = len(operands) >= 2 and str(operands[0]) == '/OC'
            if is_oc:
                layer = prop_map.get(str(operands[1]))
                stack.append(('oc', layer))
                if layer == target_name:
                    result.append((operands, operator))
            else:
                stack.append(('other',))
                if _visible(stack, target_name, include_common):
                    result.append((operands, operator))

        elif op == 'EMC':
            if not stack:
                result.append((operands, operator))
                continue
            top = stack[-1]
            was = _visible(stack, target_name, include_common)
            stack.pop()
            if (top[0] == 'oc' and top[1] == target_name) \
                    or (top[0] == 'other' and was):
                result.append((operands, operator))

        else:
            if _visible(stack, target_name, include_common):
                result.append((operands, operator))

    return result


# ---------------------------------------------------------------------------
# Stream replacement
# ---------------------------------------------------------------------------

def find_content_stream_indices(w: PdfWriter) -> list[int]:
    """
    Localiza índices en w._objects que corresponden a content streams
    (contienen operadores PDF como BT, BDC, etc.).
    """
    indices = []
    for i, obj in enumerate(w._objects):
        if obj is None:
            continue
        if hasattr(obj, 'get_data'):
            try:
                data = obj.get_data()
                if data and (b'BT' in data or b'BDC' in data or b'Do' in data):
                    indices.append(i)
            except Exception:
                pass
    return indices


def make_encoded_stream(raw_bytes: bytes, old_obj) -> EncodedStreamObject:
    """Crea un EncodedStreamObject (FlateDecode) con los bytes dados."""
    new_obj = EncodedStreamObject()
    new_obj[NameObject('/Filter')] = NameObject('/FlateDecode')
    new_obj._data = zlib.compress(raw_bytes)
    # Preservar indirect_reference para que el xref siga siendo válido
    if hasattr(old_obj, 'indirect_reference'):
        new_obj.indirect_reference = old_obj.indirect_reference
    return new_obj


# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------

def ocg_to_pages(input_path: str, output_path: str,
                 include_common: bool = True,
                 verbose: bool = False) -> bool:

    probe = PdfReader(input_path)
    ocgs  = get_ocgs(probe)

    if not ocgs:
        print("El PDF no tiene Optional Content Groups (capas).")
        return False

    if verbose:
        print(f"Entrada : {input_path}")
        print(f"OCGs ({len(ocgs)}):")
        for o in ocgs:
            print(f"  - {o['name']}")
        print()

    final = PdfWriter()

    for ocg in ocgs:
        name = ocg['name']
        if verbose:
            print(f"Procesando: {name}")

        # PdfWriter fresco por cada OCG para aislar los objetos
        w = PdfWriter()
        w.append(PdfReader(input_path))

        indices = find_content_stream_indices(w)

        for pnum, wpage in enumerate(w.pages):
            prop_map = get_prop_map(wpage)

            for idx in indices:
                old_obj = w._objects[idx]
                cs      = ContentStream(old_obj, w)
                filtered = filter_ops(list(cs.operations),
                                      prop_map, name, include_common)
                cs.operations = filtered
                w._objects[idx] = make_encoded_stream(cs.get_data(), old_obj)

            final.add_page(wpage)
            if verbose:
                print(f"  pagina fuente {pnum + 1} -> pagina output {len(final.pages)}")

    if '/OCProperties' in final._root_object:
        del final._root_object['/OCProperties']

    with open(output_path, 'wb') as f:
        final.write(f)

    print(f"\nGuardado : {output_path}")
    print(f"  OCGs          : {len(ocgs)}")
    print(f"  Paginas fuente: {len(probe.pages)}")
    print(f"  Paginas output: {len(final.pages)}")
    return True


def main():
    p = argparse.ArgumentParser(
        description="Una pagina por cada OCG del PDF.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Ejemplos:
  python ocg_to_pages_pypdf.py planos.pdf salida.pdf
  python ocg_to_pages_pypdf.py planos.pdf salida.pdf --no-common --verbose
"""
    )
    p.add_argument("input")
    p.add_argument("output")
    p.add_argument("--no-common", action="store_true",
                   help="Excluir contenido fuera de capas.")
    p.add_argument("--verbose", "-v", action="store_true")
    args = p.parse_args()

    ok = ocg_to_pages(args.input, args.output,
                      include_common=not args.no_common,
                      verbose=args.verbose)
    sys.exit(0 if ok else 1)


if __name__ == '__main__':
    main()

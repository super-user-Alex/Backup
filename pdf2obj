"""
mover_pdf_directo.py
====================
Mueve elementos de un PDF de Illustrator manipulando el content stream
directamente. Sin conversión a SVG ni rasterización.

Cómo funciona:
    Illustrator escribe en el content stream alias como /MC0, /MC1:

        /OC /MC0 BDC      <- alias, NO el nombre real del OCG
            ...paths...
        EMC

    El mapeo alias→OCG real vive en /Resources/Properties de la página.
    Este script lo resuelve antes de buscar en el stream.

    Para mover, envuelve el bloque con q / cm / Q:

        q
        1 0 0 1 dx dy cm
        /OC /MC0 BDC
            ...paths...
        EMC
        Q

Dependencias:
    pip install pikepdf pymupdf
"""

import re
import os
import tempfile
import fitz
import pikepdf
from pikepdf import Pdf, Array


# ─────────────────────────────────────────────────────────────
# HELPERS — OCG catalog
# ─────────────────────────────────────────────────────────────

def _ocg_objgen_a_nombre(pdf: Pdf) -> dict:
    """Devuelve {objgen: nombre_string} para todos los OCGs del catálogo."""
    resultado = {}
    try:
        for ref in pdf.Root["/OCProperties"]["/OCGs"]:
            resultado[ref.objgen] = str(ref["/Name"])
    except (KeyError, AttributeError):
        pass
    return resultado


def _alias_a_nombre_ocg(page_obj, objgen_a_nombre: dict) -> dict:
    """
    Lee /Resources/Properties de la página y devuelve
    {alias_string: nombre_ocg_string}  ej: {"MC0": "Logo"}
    """
    resultado = {}
    try:
        props = page_obj["/Resources"]["/Properties"]
        for key in props.keys():
            og = props[key].objgen
            if og in objgen_a_nombre:
                resultado[key] = objgen_a_nombre[og]
    except (KeyError, AttributeError):
        pass
    return resultado


def _nombre_ocg_a_alias(page_obj, objgen_a_nombre: dict) -> dict:
    """Inverso de _alias_a_nombre_ocg → {nombre_ocg: [alias1, alias2, ...]}"""
    resultado = {}
    for alias, nombre in _alias_a_nombre_ocg(page_obj, objgen_a_nombre).items():
        resultado.setdefault(nombre, []).append(alias)
    return resultado


def _leer_estados_originales(pdf: Pdf) -> dict:
    """Devuelve {nombre: bool} con visibilidad actual de cada OCG."""
    estados = {}
    try:
        oc_props    = pdf.Root["/OCProperties"]
        off_objgens = set()
        if "/OFF" in oc_props["/D"]:
            for r in oc_props["/D"]["/OFF"]:
                if hasattr(r, "objgen"):
                    off_objgens.add(r.objgen)
        for ref in oc_props["/OCGs"]:
            estados[str(ref["/Name"])] = ref.objgen not in off_objgens
    except (KeyError, AttributeError):
        pass
    return estados


def _encender_solo(pdf: Pdf, nombre_ocg: str):
    """Oculta todos los OCGs y enciende solo el indicado."""
    try:
        oc_props = pdf.Root["/OCProperties"]
        off_list = [
            ref for ref in oc_props["/OCGs"]
            if str(ref["/Name"]) != nombre_ocg
        ]
        oc_props["/D"]["/OFF"] = Array(off_list)
    except (KeyError, AttributeError):
        pass


def _restaurar_estados(pdf: Pdf, estados: dict):
    try:
        oc_props = pdf.Root["/OCProperties"]
        off_list = [
            ref for ref in oc_props["/OCGs"]
            if not estados.get(str(ref["/Name"]), True)
        ]
        oc_props["/D"]["/OFF"] = Array(off_list)
    except (KeyError, AttributeError):
        pass


def _pdf_temporal(pdf: Pdf) -> str:
    """Guarda el PDF en un archivo temporal y devuelve la ruta."""
    tmp = tempfile.NamedTemporaryFile(suffix=".pdf", delete=False)
    tmp.close()
    pdf.save(tmp.name)
    return tmp.name


# ─────────────────────────────────────────────────────────────
# 1. INSPECCIÓN
# ─────────────────────────────────────────────────────────────

def listar_ocgs(pdf_path: str) -> dict:
    """Lista los OCGs con nombre y estado. Devuelve {nombre: visible}."""
    pdf    = Pdf.open(pdf_path)
    ogmap  = _ocg_objgen_a_nombre(pdf)
    estados = _leer_estados_originales(pdf)

    if not ogmap:
        print("  El PDF no tiene OCGs.")
        print("  En Illustrator: Guardar como PDF > 'Crear capas de Acrobat'")
        pdf.close()
        return {}

    print(f"\n{'=' * 50}")
    print(f"  PDF: {pdf_path}   OCGs: {len(ogmap)}")
    print(f"{'=' * 50}")
    for nombre in ogmap.values():
        v = estados.get(nombre, True)
        print(f"  [{'ON ' if v else 'OFF'}]  {nombre}")
    print()
    pdf.close()
    return estados


def analizar_ocgs_en_stream(pdf_path: str) -> dict:
    """
    Muestra los alias del content stream y a qué OCG corresponden.
    Devuelve {nombre_ocg: [alias, ...]}
    """
    pdf      = Pdf.open(pdf_path)
    page     = pdf.pages[0]
    ogmap    = _ocg_objgen_a_nombre(pdf)
    alias_map = _alias_a_nombre_ocg(page.obj, ogmap)

    contenido = page.obj.get("/Contents")
    if isinstance(contenido, pikepdf.Array):
        raw = b"".join(s.read_bytes() for s in contenido)
    else:
        raw = contenido.read_bytes()

    patron   = rb'/OC\s+/(\S+)\s+BDC'
    en_stream = [m.group(1).decode() for m in re.finditer(patron, raw)]

    print(f"\n{'=' * 55}")
    print("  Alias en stream  →  Nombre OCG real")
    print(f"{'=' * 55}")
    resultado = {}
    for alias in sorted(set(en_stream)):
        nombre = alias_map.get(alias, "(sin mapeo en Resources/Properties)")
        conteo = en_stream.count(alias)
        print(f"  /{alias:12s}  →  '{nombre}'  ({conteo} bloque{'s' if conteo>1 else ''})")
        if nombre != "(sin mapeo en Resources/Properties)":
            resultado.setdefault(nombre, []).append(alias)
    print()
    pdf.close()
    return resultado


def analizar_estructura_pdf(pdf_path: str) -> dict:
    """Posición y tamaño de cada OCG. Devuelve {nombre: {bbox, num_elementos}}."""
    pdf    = Pdf.open(pdf_path)
    ogmap  = _ocg_objgen_a_nombre(pdf)
    estados_orig = _leer_estados_originales(pdf)
    estructura   = {}

    print(f"\n{'=' * 55}")
    print(f"  Estructura: {pdf_path}")
    print(f"{'=' * 55}")

    for nombre in ogmap.values():
        _encender_solo(pdf, nombre)
        tmp = _pdf_temporal(pdf)

        doc   = fitz.open(tmp)
        paths = doc[0].get_drawings()
        doc.close()
        os.unlink(tmp)

        if paths:
            x0 = min(p["rect"].x0 for p in paths)
            y0 = min(p["rect"].y0 for p in paths)
            x1 = max(p["rect"].x1 for p in paths)
            y1 = max(p["rect"].y1 for p in paths)
            bbox = (round(x0,2), round(y0,2), round(x1,2), round(y1,2))
        else:
            bbox = None

        estructura[nombre] = {"bbox": bbox, "num_elementos": len(paths)}
        v = estados_orig.get(nombre, True)
        print(f"\n  OCG: '{nombre}'  [{'ON' if v else 'OFF'}]")
        print(f"    Elementos : {len(paths)}")
        if bbox:
            print(f"    Posicion  : x={bbox[0]}, y={bbox[1]}  (top-down)")
            print(f"    Tamano    : {bbox[2]-bbox[0]:.1f} x {bbox[3]-bbox[1]:.1f} pts")
        else:
            print(f"    Sin elementos vectoriales detectados")

    _restaurar_estados(pdf, estados_orig)
    pdf.close()
    print()
    return estructura


# ─────────────────────────────────────────────────────────────
# 2. MANIPULACIÓN DEL CONTENT STREAM
# ─────────────────────────────────────────────────────────────

def _modificar_stream(raw: bytes, aliases: list, dx: float, dy: float) -> bytes:
    """
    Envuelve con q/cm/Q cada bloque BDC de cualquiera de los aliases dados.

    aliases: lista de strings como ["MC0", "MC1"] que corresponden al OCG
    """
    # Construir patrón que matchee cualquiera de los aliases
    alternativas = b"|".join(re.escape(a.encode()) for a in aliases)
    patron_bdc   = re.compile(
        rb'/OC\s+/(' + alternativas + rb')\s+BDC'
    )

    translate_in  = f"q\n1 0 0 1 {dx} {dy} cm\n".encode()
    translate_out = b"Q\n"

    output  = []
    en_ocg  = 0

    for linea in raw.split(b"\n"):
        stripped = linea.strip()

        if patron_bdc.search(stripped):
            output.append(translate_in)
            output.append(linea)
            en_ocg += 1

        elif stripped == b"EMC" and en_ocg > 0:
            output.append(linea)
            output.append(translate_out)
            en_ocg -= 1

        else:
            output.append(linea)

    return b"\n".join(output)


# ─────────────────────────────────────────────────────────────
# 3. FUNCIONES PRINCIPALES
# ─────────────────────────────────────────────────────────────

def mover_ocg_directo(pdf_path: str, nombre_ocg: str,
                      dx: float, dy: float,
                      output_pdf: str = "resultado.pdf") -> str:
    """
    Mueve un OCG completo por desplazamiento relativo (dx, dy).

    Args:
        nombre_ocg : Nombre del OCG (usar listar_ocgs() para ver los nombres).
        dx         : Desplazamiento horizontal en pts (positivo = derecha).
        dy         : Desplazamiento vertical PDF (positivo = arriba, negativo = abajo).
    """
    pdf    = Pdf.open(pdf_path)
    ogmap  = _ocg_objgen_a_nombre(pdf)

    nombres_disponibles = list(ogmap.values())
    if nombre_ocg not in nombres_disponibles:
        pdf.close()
        raise ValueError(
            f"OCG '{nombre_ocg}' no encontrado.\n"
            f"Disponibles: {nombres_disponibles}"
        )

    movidos = 0
    for i, page in enumerate(pdf.pages):
        # Resolver alias para esta página
        nombre_a_aliases = _nombre_ocg_a_alias(page.obj, ogmap)
        aliases = nombre_a_aliases.get(nombre_ocg, [])

        if not aliases:
            print(f"  Pagina {i+1}: OCG '{nombre_ocg}' no tiene alias en esta página, omitida")
            continue

        print(f"  Pagina {i+1}: aliases encontrados → {['/' + a for a in aliases]}")

        contenido = page.obj.get("/Contents")
        if contenido is None:
            continue

        if isinstance(contenido, pikepdf.Array):
            for stream_obj in contenido:
                raw = stream_obj.read_bytes()
                mod = _modificar_stream(raw, aliases, dx, dy)
                if mod != raw:
                    stream_obj.write(mod)
                    movidos += 1
        else:
            raw = contenido.read_bytes()
            mod = _modificar_stream(raw, aliases, dx, dy)
            if mod != raw:
                contenido.write(mod)
                movidos += 1

    if movidos == 0:
        print(f"  ADVERTENCIA: no se modificó ningún stream.")
        print(f"  Ejecuta analizar_ocgs_en_stream('{pdf_path}') para diagnosticar.")
    else:
        print(f"  Streams modificados: {movidos}")

    pdf.save(output_pdf)
    pdf.close()
    print(f"\n  Guardado: {output_pdf}")
    return output_pdf


def mover_ocg_a_posicion(pdf_path: str, nombre_ocg: str,
                          nuevo_x: float, nuevo_y: float,
                          output_pdf: str = "resultado.pdf") -> str:
    """
    Mueve un OCG a posición absoluta (coordenadas top-down como Illustrator).

    Args:
        nuevo_x : X destino en pts desde borde izquierdo.
        nuevo_y : Y destino en pts desde borde SUPERIOR (como Illustrator).
    """
    pdf    = Pdf.open(pdf_path)
    ogmap  = _ocg_objgen_a_nombre(pdf)
    estados_orig = _leer_estados_originales(pdf)

    if nombre_ocg not in ogmap.values():
        pdf.close()
        raise ValueError(f"OCG '{nombre_ocg}' no encontrado. Disponibles: {list(ogmap.values())}")

    _encender_solo(pdf, nombre_ocg)
    tmp = _pdf_temporal(pdf)
    _restaurar_estados(pdf, estados_orig)
    pdf.close()

    doc    = fitz.open(tmp)
    page   = doc[0]
    paths  = page.get_drawings()
    doc.close()
    os.unlink(tmp)

    if not paths:
        raise ValueError(f"OCG '{nombre_ocg}' no tiene elementos medibles.")

    x0_actual = min(p["rect"].x0 for p in paths)
    y0_actual = min(p["rect"].y0 for p in paths)   # top-down

    # PDF content stream usa Y bottom-up
    # dy en stream = -(desplazamiento_pantalla)
    dx = nuevo_x - x0_actual
    dy = -(nuevo_y - y0_actual)

    print(f"\n  Posicion actual : x={x0_actual:.1f}, y={y0_actual:.1f}  (top-down)")
    print(f"  Posicion destino: x={nuevo_x:.1f},   y={nuevo_y:.1f}  (top-down)")
    print(f"  Operador cm     : dx={dx:.1f}, dy={dy:.1f}")

    return mover_ocg_directo(pdf_path, nombre_ocg, dx, dy, output_pdf)


# ─────────────────────────────────────────────────────────────
# 4. VERIFICACIÓN
# ─────────────────────────────────────────────────────────────

def verificar_posicion_ocg(pdf_path: str, nombre_ocg: str):
    """Muestra la bounding box del OCG en el PDF resultante."""
    pdf    = Pdf.open(pdf_path)
    ogmap  = _ocg_objgen_a_nombre(pdf)
    estados_orig = _leer_estados_originales(pdf)

    if nombre_ocg not in ogmap.values():
        print(f"  OCG '{nombre_ocg}' no encontrado.")
        pdf.close()
        return

    _encender_solo(pdf, nombre_ocg)
    tmp = _pdf_temporal(pdf)
    _restaurar_estados(pdf, estados_orig)
    pdf.close()

    doc   = fitz.open(tmp)
    paths = doc[0].get_drawings()
    doc.close()
    os.unlink(tmp)

    print(f"\n  Verificacion '{nombre_ocg}' en {pdf_path}:")
    if paths:
        x0 = min(p["rect"].x0 for p in paths)
        y0 = min(p["rect"].y0 for p in paths)
        x1 = max(p["rect"].x1 for p in paths)
        y1 = max(p["rect"].y1 for p in paths)
        print(f"  Posicion: x={x0:.1f}, y={y0:.1f}  (top-down)")
        print(f"  Tamano  : {x1-x0:.1f} x {y1-y0:.1f} pts")
    else:
        print("  Sin elementos detectables.")



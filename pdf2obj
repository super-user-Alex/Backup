import pymupdf
import re

def get_swatches(doc):
    """
    Extrae colores con nombre (Separation colorspaces) del PDF.
    Retorna dict: {"NombreSwatch": (c, m, y, k)} o (r, g, b)
    """
    swatches = {}
    
    for xref in range(1, doc.xref_length()):
        try:
            obj_str = doc.xref_object(xref, compressed=False)
        except:
            continue
        
        # Buscar colorspaces tipo Separation
        if "/Separation" in obj_str:
            # Extraer el nombre del swatch
            match = re.search(r'/Separation\s+/([^\s/\]>]+)', obj_str)
            if match:
                name = match.group(1)
                # Buscar valores CMYK o RGB en la función de conversión
                # (los valores están como números en la tint transform)
                values = re.findall(r'\b(0(?:\.\d+)?|1(?:\.0+)?|\.\d+)\b', obj_str)
                if values:
                    floats = [float(v) for v in values]
                    swatches[name] = floats
    
    return swatches

# Uso
doc = pymupdf.open("mi_archivo.pdf")
swatches = get_swatches(doc)
print(swatches)

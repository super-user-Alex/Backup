if __name__ == "__main__":
    import sys

    if len(sys.argv) < 2:
        print(__doc__)
        print("\n── DEMO: crea un PDF de prueba con OCGs y aplica transformaciones ──\n")

        # Crear PDF de prueba con pikepdf si no se pasa un archivo
        try:
            import pikepdf
            from pikepdf import Pdf, Dictionary, Array, Name, Stream

            pdf = Pdf.new()
            page = pikepdf.Page(
                pikepdf.Dictionary(
                    Type=Name("/Page"),
                    MediaBox=Array([0, 0, 595, 842]),
                )
            )
            pdf.pages.append(page)

            # Definir dos OCGs
            ocg1 = pdf.make_indirect(Dictionary(Type=Name("/OCG"), Name="Capa1"))
            ocg2 = pdf.make_indirect(Dictionary(Type=Name("/OCG"), Name="Capa2"))

            pdf.Root["/OCProperties"] = Dictionary(
                OCGs=Array([ocg1, ocg2]),
                D=Dictionary(Order=Array([ocg1, ocg2])),
            )

            # Content stream con dos capas
            content = b"""
/OC /Capa1 BDC
  1 0 0 RG   % color rojo
  100 100 m
  200 100 l
  200 200 l
  100 200 l
  h S
EMC
/OC /Capa2 BDC
  0 0 1 RG   % color azul
  300 300 50 0 360 arc S
EMC
"""
            stream = pdf.make_stream(content)
            page.obj["/Contents"] = stream

            # Registrar los OCGs como recursos de la página
            page.obj["/Resources"] = Dictionary(
                Properties=Dictionary(
                    Capa1=ocg1,
                    Capa2=ocg2,
                )
            )

            pdf.save("demo_input.pdf")
            print("PDF de demo creado: demo_input.pdf")

            # Ahora transformar
            t = PDFOCGTransformer("demo_input.pdf")
            t.list_ocgs()
            t.translate("Capa1", tx=50, ty=30)
            t.rotate("Capa2", angle_deg=45, cx=300, cy=300)
            t.save("demo_output.pdf")

        except Exception as e:
            print(f"Error en demo: {e}")
            raise

    else:
        # Uso: python ocg_transform.py entrada.pdf salida.pdf
        input_pdf  = sys.argv[1]
        output_pdf = sys.argv[2] if len(sys.argv) > 2 else "output.pdf"

        t = PDFOCGTransformer(input_pdf)
        t.list_ocgs()


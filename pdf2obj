if __name__ == "__main__":
    import sys

    if len(sys.argv) >= 2:
        inp = sys.argv[1]
        out = sys.argv[2] if len(sys.argv) > 2 else "output.pdf"

        t = PDFOCGTransformer(inp)
        t.list_ocgs()   # ← ejecuta primero; copia los nombres exactos


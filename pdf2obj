"""
ocg_transform.py
================
Aplica transformaciones affine (rotación, traslación, escala) a los paths
de OCGs (Optional Content Groups) en un PDF usando pikepdf.

La clave del fix: en los content streams los OCGs aparecen como
    /OC /Mc0 BDC   ← "Mc0" es la clave de recurso, NO el nombre del OCG
El script resuelve automáticamente la clave de recurso por página.

Instalación:
    pip install pikepdf numpy

Uso:
    from ocg_transform import PDFOCGTransformer

    t = PDFOCGTransformer("entrada.pdf")
    t.list_ocgs()                                   # ver capas
    t.translate("NombreCapa", tx=50, ty=-30)
    t.rotate("OtraCapa", angle_deg=45, cx=100, cy=200)
    t.save("salida.pdf")
"""

import math
import re
import numpy as np
import pikepdf
from pikepdf import Pdf, Array, Name, Dictionary


# ── Matrices affine ────────────────────────────────────────────────────────

def mat_identity() -> np.ndarray:
    return np.eye(3)


def mat_translate(tx: float, ty: float) -> np.ndarray:
    m = np.eye(3)
    m[2, 0] = tx
    m[2, 1] = ty
    return m


def mat_rotate(angle_deg: float, cx: float = 0.0, cy: float = 0.0) -> np.ndarray:
    rad = math.radians(angle_deg)
    cos_a, sin_a = math.cos(rad), math.sin(rad)
    r = np.array([[cos_a, sin_a, 0],
                  [-sin_a, cos_a, 0],
                  [0,      0,     1]])
    return mat_translate(-cx, -cy) @ r @ mat_translate(cx, cy)


def mat_scale(sx: float, sy: float, cx: float = 0.0, cy: float = 0.0) -> np.ndarray:
    s = np.array([[sx, 0, 0],
                  [0, sy, 0],
                  [0,  0, 1]])
    return mat_translate(-cx, -cy) @ s @ mat_translate(cx, cy)


def mat_to_cm(m: np.ndarray) -> str:
    """Convierte matriz 3x3 numpy a los 6 operandos del operador PDF 'cm'."""
    # PDF: a b c d e f cm
    # a=m[0,0] b=m[0,1] c=m[1,0] d=m[1,1] e=m[2,0] f=m[2,1]
    a, b = m[0, 0], m[0, 1]
    c, d = m[1, 0], m[1, 1]
    e, f = m[2, 0], m[2, 1]
    return f"{a:.6f} {b:.6f} {c:.6f} {d:.6f} {e:.6f} {f:.6f} cm"


# ── Lectura/escritura de streams ───────────────────────────────────────────

def _read_stream(page: pikepdf.Page) -> bytes:
    """Lee y concatena el/los content stream(s) de la pagina."""
    contents = page.obj.get("/Contents")
    if contents is None:
        return b""
    if isinstance(contents, pikepdf.Array):
        return b" ".join(item.read_bytes() for item in contents)
    return contents.read_bytes()


def _write_stream(pdf: Pdf, page: pikepdf.Page, data: bytes):
    """Reemplaza el content de la pagina con un unico stream nuevo."""
    page.obj["/Contents"] = pdf.make_stream(data)


# ── Mapeo clave-de-recurso <-> nombre del OCG ─────────────────────────────

def _resource_key_to_ocg_name(page: pikepdf.Page) -> dict:
    """
    Devuelve {clave_recurso: nombre_OCG} para la pagina.
    Ejemplo: {"Mc0": "Capa1", "Mc1": "Capa2"}
    La clave de recurso es lo que aparece en el stream: /OC /Mc0 BDC
    """
    mapping = {}
    try:
        props = page.obj["/Resources"]["/Properties"]
        for key, ref in props.items():
            obj = ref
            name_val = obj.get("/Name")
            if name_val is not None:
                # key viene como "/Mc0", quitamos la barra
                clean_key = str(key).lstrip("/")
                mapping[clean_key] = str(name_val)
    except (KeyError, AttributeError):
        pass
    return mapping


def _ocg_name_to_resource_keys(page: pikepdf.Page) -> dict:
    """Invierte el mapeo: {nombre_OCG: [clave_recurso, ...]}."""
    inv = {}
    for rk, ocg_name in _resource_key_to_ocg_name(page).items():
        inv.setdefault(ocg_name, []).append(rk)
    return inv


# ── Tokenizador minimo de content stream ──────────────────────────────────

_TOKEN_RE = re.compile(
    rb'('
    rb'\((?:[^\\()]|\\.)*\)|'   # string literal  ( ... )
    rb'<[0-9A-Fa-f\s]*>|'      # string hex       < ... >
    rb'<<|>>|'                  # diccionario delimiters
    rb'[^\s\(\)<>\[\]{}/%]+|'  # token normal (nombre, numero, operador)
    rb'/[^\s\(\)<>\[\]{}/%]*|'  # nombre PDF  /Foo
    rb'\s+|'                    # espacios
    rb'.'                        # cualquier otro caracter
    rb')',
    re.DOTALL,
)


def _tokenize(data: bytes) -> list:
    return [m.group() for m in _TOKEN_RE.finditer(data)]


# ── Inyeccion de la matriz cm en el stream ────────────────────────────────

def _inject_cm_for_keys(data: bytes, resource_keys: list, cm_str: str) -> bytes:
    """
    Recorre el stream token a token buscando:
        /OC  /<resource_key>  BDC
    y envuelve el bloque hasta el EMC correspondiente con:
        q <cm_str>
        ... contenido original ...
        Q
    Maneja anidamiento de BDC/EMC correctamente.
    """
    tokens = _tokenize(data)
    n = len(tokens)
    out = []
    i = 0
    rk_bytes = {("/" + k).encode() for k in resource_keys}

    while i < n:
        tok = tokens[i].strip()

        # Buscar /OC
        if tok == b"/OC":
            # Siguiente token no-espacio
            j = i + 1
            while j < n and not tokens[j].strip():
                j += 1

            rk_tok = tokens[j].strip() if j < n else b""  # ej. b"/Mc0"

            # Siguiente token no-espacio despues de la clave
            k = j + 1
            while k < n and not tokens[k].strip():
                k += 1

            bdc_tok = tokens[k].strip() if k < n else b""  # deberia ser b"BDC"

            if bdc_tok == b"BDC" and rk_tok in rk_bytes:
                # Emitir /OC /rk BDC, luego q + cm
                out.extend(tokens[i:k + 1])
                out.append(f"\nq\n{cm_str}\n".encode())
                i = k + 1

                # Avanzar hasta el EMC correspondiente con depth tracking
                depth = 1
                while i < n and depth > 0:
                    t = tokens[i].strip()
                    if t in (b"BDC", b"BMC"):
                        depth += 1
                        out.append(tokens[i])
                    elif t == b"EMC":
                        depth -= 1
                        if depth == 0:
                            out.append(b"\nQ\n")
                            out.append(tokens[i])  # EMC
                            i += 1
                            break
                        else:
                            out.append(tokens[i])
                    else:
                        out.append(tokens[i])
                    i += 1
                continue

        out.append(tokens[i])
        i += 1

    return b"".join(out)


# ── Clase principal ────────────────────────────────────────────────────────

class PDFOCGTransformer:
    """
    Aplica transformaciones affine a OCGs de un PDF.

    Ejemplo completo:
        t = PDFOCGTransformer("plano.pdf")
        t.list_ocgs()
        t.translate("Instalaciones", tx=100, ty=0)
        t.rotate("Estructura", angle_deg=15, cx=297, cy=420)
        t.scale("Mobiliario", sx=0.5, sy=0.5)
        t.save("plano_modificado.pdf")
    """

    def __init__(self, path: str):
        self.pdf = Pdf.open(path)
        self._transforms = {}  # nombre_OCG -> matriz 3x3 acumulada

    # ── Inspeccion ────────────────────────────────────────────────────────

    def list_ocgs(self):
        """Muestra los OCGs del PDF y sus claves de recurso por pagina."""
        print("\n=== OCGs declarados en /OCProperties ===")
        try:
            ocgs = self.pdf.Root["/OCProperties"]["/OCGs"]
            for ref in ocgs:
                name = str(ref.get("/Name", "(sin nombre)"))
                mark = "★" if name in self._transforms else " "
                print(f"  [{mark}] '{name}'")
        except (KeyError, AttributeError):
            print("  No se encontro /OCProperties en el PDF.")

        print("\n=== Claves de recurso en /Resources/Properties por pagina ===")
        found_any = False
        for i, page in enumerate(self.pdf.pages):
            mapping = _resource_key_to_ocg_name(page)
            if mapping:
                found_any = True
                for rk, ocg_name in mapping.items():
                    print(f"  Pagina {i+1}: clave='{rk}' -> OCG='{ocg_name}'")
        if not found_any:
            print("  No se encontraron propiedades OCG en ninguna pagina.")
        print()

    # ── Acumulacion de transformaciones ───────────────────────────────────

    def _acc(self, name: str, m: np.ndarray):
        prev = self._transforms.get(name, mat_identity())
        self._transforms[name] = prev @ m

    def translate(self, ocg_name: str, tx: float, ty: float):
        """Traslacion en puntos PDF (1 punto = 1/72 pulgada)."""
        self._acc(ocg_name, mat_translate(tx, ty))
        print(f"[translate] '{ocg_name}' tx={tx} ty={ty}")

    def rotate(self, ocg_name: str, angle_deg: float,
               cx: float = 0.0, cy: float = 0.0):
        """Rotacion antihoraria en grados alrededor del punto (cx, cy)."""
        self._acc(ocg_name, mat_rotate(angle_deg, cx, cy))
        print(f"[rotate]    '{ocg_name}' {angle_deg} grados en ({cx},{cy})")

    def scale(self, ocg_name: str, sx: float, sy: float,
              cx: float = 0.0, cy: float = 0.0):
        """Escala con centro en (cx, cy). sx=sy=1.0 es identidad."""
        self._acc(ocg_name, mat_scale(sx, sy, cx, cy))
        print(f"[scale]     '{ocg_name}' sx={sx} sy={sy} en ({cx},{cy})")

    def set_matrix(self, ocg_name: str, matrix: np.ndarray):
        """Establece directamente la matriz affine 3x3 (sobreescribe todo lo anterior)."""
        assert matrix.shape == (3, 3), "La matriz debe ser 3x3"
        self._transforms[ocg_name] = matrix.copy()
        print(f"[set_matrix] '{ocg_name}'")

    # ── Aplicar y guardar ─────────────────────────────────────────────────

    def save(self, output_path: str):
        """Aplica todas las transformaciones acumuladas y guarda el PDF resultante."""
        if not self._transforms:
            print("Advertencia: no hay transformaciones definidas.")

        changed_pages = 0
        for page_num, page in enumerate(self.pdf.pages):
            name_to_keys = _ocg_name_to_resource_keys(page)
            raw = _read_stream(page)
            modified = raw

            for ocg_name, mat in self._transforms.items():
                rkeys = name_to_keys.get(ocg_name, [])
                if not rkeys:
                    continue
                cm_str = mat_to_cm(mat)
                modified = _inject_cm_for_keys(modified, rkeys, cm_str)

            if modified != raw:
                _write_stream(self.pdf, page, modified)
                print(f"  Pagina {page_num + 1}: modificada")
                changed_pages += 1

        if changed_pages == 0:
            print("Advertencia: no se modifico ninguna pagina.")
            print("Verifica que los nombres de OCG coincidan exactamente con los de list_ocgs().")
        
        self.pdf.save(output_path)
        print(f"\n OK Guardado en: {output_path}")



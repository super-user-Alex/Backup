    analizar_estructura_pdf(PDF)

    # 4a. Mover por desplazamiento relativo
    mover_ocg_directo(
        pdf_path=PDF,
        nombre_ocg="Logo",   # nombre exacto de listar_ocgs()
        dx=100,              # 100 pts a la derecha

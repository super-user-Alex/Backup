"""
ocg_transform.py
================
Aplica transformaciones affine (rotación, traslación, escala) a los paths
de OCGs (Optional Content Groups) en un PDF, usando pikepdf.

Instalación:
    pip install pikepdf numpy

Uso rápido:
    python ocg_transform.py

Uso programático:
    from ocg_transform import PDFOCGTransformer
    import numpy as np

    t = PDFOCGTransformer("entrada.pdf")
    t.list_ocgs()
    t.translate("MiCapa", tx=50, ty=-30)
    t.rotate("OtraCapa", angle_deg=45, cx=100, cy=200)
    t.save("salida.pdf")
"""

import math
import re
import numpy as np
import pikepdf
from pikepdf import Pdf, Array, Name, Dictionary


# ---------------------------------------------------------------------------
# Matrices affine helpers (espacio PDF: columna mayor, 6 valores [a b c d e f])
# PDF usa: [a b 0 / c d 0 / tx ty 1]  → operador cm: a b c d tx ty cm
# ---------------------------------------------------------------------------

def mat_identity() -> np.ndarray:
    """Matriz identidad 3×3."""
    return np.eye(3)


def mat_translate(tx: float, ty: float) -> np.ndarray:
    """Matriz de traslación."""
    m = np.eye(3)
    m[2, 0] = tx
    m[2, 1] = ty
    return m


def mat_rotate(angle_deg: float, cx: float = 0.0, cy: float = 0.0) -> np.ndarray:
    """
    Matriz de rotación alrededor del punto (cx, cy).
    Ángulo positivo = sentido antihorario (convenio PDF/matemático).
    """
    rad = math.radians(angle_deg)
    cos_a = math.cos(rad)
    sin_a = math.sin(rad)
    # Rotate around origin
    r = np.array([
        [cos_a,  sin_a, 0],
        [-sin_a, cos_a, 0],
        [0,      0,     1],
    ])
    # Trasladar al origen, rotar, volver
    t_back = mat_translate(cx, cy)
    t_orig = mat_translate(-cx, -cy)
    return t_orig @ r @ t_back   # columna mayor: aplica de derecha a izquierda


def mat_scale(sx: float, sy: float, cx: float = 0.0, cy: float = 0.0) -> np.ndarray:
    """Matriz de escala alrededor del punto (cx, cy)."""
    s = np.array([
        [sx, 0,  0],
        [0,  sy, 0],
        [0,  0,  1],
    ])
    t_back = mat_translate(cx, cy)
    t_orig = mat_translate(-cx, -cy)
    return t_orig @ s @ t_back


def mat_to_cm_operands(m: np.ndarray) -> str:
    """
    Convierte matriz 3×3 a los 6 valores del operador PDF 'cm'.
    Convenio PDF (row-major, transpuesto respecto a numpy col-major):
        a = m[0,0], b = m[0,1], c = m[1,0], d = m[1,1]
        tx= m[2,0], ty= m[2,1]
    """
    a  = m[0, 0]; b  = m[0, 1]
    c  = m[1, 0]; d  = m[1, 1]
    tx = m[2, 0]; ty = m[2, 1]
    return f"{a:.6f} {b:.6f} {c:.6f} {d:.6f} {tx:.6f} {ty:.6f} cm"


# ---------------------------------------------------------------------------
# Manipulación del content stream
# ---------------------------------------------------------------------------

def _inject_matrix_into_stream(raw: bytes, ocg_name: str, cm_str: str) -> bytes:
    """
    Busca los marcadores BDC/EMC del OCG dado en el content stream y envuelve
    su contenido con:
        q
        <cm_str>
        ... contenido original ...
        Q

    Soporta tanto '/OC /<name> BDC' como '/<name> BDC' (propiedad en recurso).
    """
    text = raw.decode("latin-1")  # latin-1 preserva bytes sin modificar

    # Patron BDC para este OCG (acepta /OC /Name BDC  o bien  /Name BDC)
    bdc_pattern = re.compile(
        r'(/OC\s+/' + re.escape(ocg_name) + r'\s+BDC'
        r'|/' + re.escape(ocg_name) + r'\s+BDC)',
    )

    result = []
    pos = 0
    depth = 0  # anidamiento de BDC/EMC para el OCG actual

    # Tokenizamos manualmente para manejar anidamiento
    for m in bdc_pattern.finditer(text):
        result.append(text[pos:m.start()])
        result.append(m.group())  # el marcador BDC original
        result.append(f"\nq\n{cm_str}\n")
        # Ahora buscamos el EMC correspondiente
        inner_start = m.end()
        depth = 1
        i = inner_start
        while i < len(text) and depth > 0:
            if text[i:i+3] == "BDC" or text[i:i+3] == "BMC":
                depth += 1
                i += 3
            elif text[i:i+3] == "EMC":
                depth -= 1
                if depth == 0:
                    # Insertar Q justo antes del EMC
                    result.append(text[inner_start:i])
                    result.append("\nQ\n")
                    result.append("EMC")
                    pos = i + 3
                    inner_start = pos
                    break
                i += 3
            else:
                i += 1
        else:
            # No se encontró el EMC: dejar el stream intacto
            result.append(text[inner_start:])
            pos = len(text)

    result.append(text[pos:])
    return "".join(result).encode("latin-1")


def _get_stream_bytes(page: pikepdf.Page) -> bytes:
    """
    Devuelve el content stream completo de una página (puede ser Array o Stream).
    """
    contents = page.obj.get("/Contents")
    if contents is None:
        return b""
    if isinstance(contents, pikepdf.Array):
        parts = []
        for ref in contents:
            obj = ref
            if hasattr(obj, "read_bytes"):
                parts.append(obj.read_bytes())
            else:
                parts.append(bytes(obj))
        return b" ".join(parts)
    else:
        return contents.read_bytes()


def _set_stream_bytes(pdf: Pdf, page: pikepdf.Page, data: bytes):
    """
    Reemplaza el content stream de la página con `data`.
    Siempre crea un único stream nuevo (simplifica el manejo).
    """
    new_stream = pdf.make_stream(data)
    page.obj["/Contents"] = new_stream


# ---------------------------------------------------------------------------
# Clase principal
# ---------------------------------------------------------------------------

class PDFOCGTransformer:
    """
    Carga un PDF y permite aplicar transformaciones affine a cada OCG.

    Ejemplo:
        t = PDFOCGTransformer("plano.pdf")
        t.list_ocgs()
        t.translate("Capa1", tx=100, ty=50)
        t.rotate("Capa2", angle_deg=30, cx=300, cy=400)
        t.save("plano_modificado.pdf")
    """

    def __init__(self, path: str):
        self.pdf = Pdf.open(path)
        self._ocg_names = self._collect_ocg_names()
        # Acumular transformaciones: { ocg_name: np.ndarray (matriz 3×3) }
        self._transforms: dict[str, np.ndarray] = {}

    # ------------------------------------------------------------------
    # Inspección
    # ------------------------------------------------------------------

    def _collect_ocg_names(self) -> dict[str, str]:
        """
        Retorna {nombre_legible: nombre_interno_PDF} de todos los OCGs.
        El nombre interno es el que aparece en los streams (clave del dict de recursos).
        """
        names = {}
        try:
            ocgs = self.pdf.Root["/OCProperties"]["/OCGs"]
            for ref in ocgs:
                ocg = ref
                label = str(ocg.get("/Name", ""))
                # El nombre interno en recursos puede diferir; usamos el mismo
                names[label] = label
        except (KeyError, AttributeError):
            pass
        return names

    def list_ocgs(self):
        """Imprime los OCGs disponibles en el PDF."""
        print("OCGs encontrados en el PDF:")
        if not self._ocg_names:
            print("  (ninguno detectado)")
            return
        for name in self._ocg_names:
            status = "✓ con transform" if name in self._transforms else "  sin transform"
            print(f"  [{status}] '{name}'")

    # ------------------------------------------------------------------
    # Acumulación de transformaciones
    # ------------------------------------------------------------------

    def _accumulate(self, ocg_name: str, matrix: np.ndarray):
        """Combina la nueva matriz con la acumulada para el OCG."""
        prev = self._transforms.get(ocg_name, mat_identity())
        self._transforms[ocg_name] = prev @ matrix

    def translate(self, ocg_name: str, tx: float, ty: float):
        """Añade una traslación (tx, ty) en puntos PDF al OCG especificado."""
        self._accumulate(ocg_name, mat_translate(tx, ty))
        print(f"[translate] '{ocg_name}' → tx={tx}, ty={ty}")

    def rotate(self, ocg_name: str, angle_deg: float,
               cx: float = 0.0, cy: float = 0.0):
        """
        Añade una rotación de `angle_deg` grados (antihorario) al OCG,
        alrededor del punto (cx, cy) en puntos PDF.
        """
        self._accumulate(ocg_name, mat_rotate(angle_deg, cx, cy))
        print(f"[rotate]    '{ocg_name}' → {angle_deg}° en ({cx},{cy})")

    def scale(self, ocg_name: str, sx: float, sy: float,
              cx: float = 0.0, cy: float = 0.0):
        """
        Añade una escala (sx, sy) al OCG, con centro en (cx, cy).
        sx=sy=1.0 es identidad.
        """
        self._accumulate(ocg_name, mat_scale(sx, sy, cx, cy))
        print(f"[scale]     '{ocg_name}' → sx={sx}, sy={sy} en ({cx},{cy})")

    def set_matrix(self, ocg_name: str, matrix: np.ndarray):
        """
        Establece directamente la matriz affine 3×3 para un OCG.
        Sobreescribe cualquier transformación previa.
        """
        assert matrix.shape == (3, 3), "La matriz debe ser 3×3"
        self._transforms[ocg_name] = matrix
        print(f"[set_matrix] '{ocg_name}' → matriz personalizada")

    # ------------------------------------------------------------------
    # Escritura
    # ------------------------------------------------------------------

    def apply_and_save(self, output_path: str):
        """
        Aplica todas las transformaciones acumuladas al PDF y guarda el resultado.
        """
        for page in self.pdf.pages:
            raw = _get_stream_bytes(page)
            modified = raw
            for ocg_name, mat in self._transforms.items():
                cm_str = mat_to_cm_operands(mat)
                modified = _inject_matrix_into_stream(modified, ocg_name, cm_str)
            if modified != raw:
                _set_stream_bytes(self.pdf, page, modified)

        self.pdf.save(output_path)
        print(f"\n✅ PDF guardado en: {output_path}")

    # Alias conveniente
    def save(self, output_path: str):
        self.apply_and_save(output_path)



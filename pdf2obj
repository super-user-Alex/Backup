import pikepdf
from pikepdf import parse_content_stream, unparse_content_stream, Object, Array, Name
from pikepdf._qpdf import ContentStreamInstruction, ContentStreamInlineImage


# ============================================================
# 1. TRASLACIÓN DE OPERADORES PDF
# ============================================================

def to_float(operand):
    """Convierte un operando pikepdf a float."""
    return float(operand)

def to_pdf_number(value):
    """Convierte un float a objeto pikepdf numérico."""
    return pikepdf.Decimal(f"{value:.4f}")

def translate_instruction(instruction, dx, dy):
    """
    Recibe un ContentStreamInstruction y retorna los operandos modificados.
    Aplica dx, dy a los operadores que contienen coordenadas.
    """
    op = str(instruction.operator)
    operands = list(instruction.operands)

    def s(val, delta):
        return to_pdf_number(to_float(val) + delta)

    # ── Path construction ──────────────────────────────────
    if op == 're':        # x y w h re  →  rectángulo
        return [s(operands[0], dx), s(operands[1], dy), operands[2], operands[3]]

    if op == 'm':         # x y m  →  moveto
        return [s(operands[0], dx), s(operands[1], dy)]

    if op == 'l':         # x y l  →  lineto
        return [s(operands[0], dx), s(operands[1], dy)]

    if op == 'c':         # x1 y1 x2 y2 x3 y3 c  →  curveto
        return [s(operands[0], dx), s(operands[1], dy),
                s(operands[2], dx), s(operands[3], dy),
                s(operands[4], dx), s(operands[5], dy)]

    if op == 'v':         # x2 y2 x3 y3 v
        return [s(operands[0], dx), s(operands[1], dy),
                s(operands[2], dx), s(operands[3], dy)]

    if op == 'y':         # x1 y1 x3 y3 y
        return [s(operands[0], dx), s(operands[1], dy),
                s(operands[2], dx), s(operands[3], dy)]

    # ── Texto ──────────────────────────────────────────────
    if op == 'Td' or op == 'TD':   # tx ty Td
        return [s(operands[0], dx), s(operands[1], dy)]

    if op == 'Tm':        # a b c d e f Tm  (e=tx, f=ty)
        return [operands[0], operands[1], operands[2], operands[3],
                s(operands[4], dx), s(operands[5], dy)]

    # ── Transformación de matriz ───────────────────────────
    if op == 'cm':        # a b c d e f cm  (e=tx, f=ty)
        return [operands[0], operands[1], operands[2], operands[3],
                s(operands[4], dx), s(operands[5], dy)]

    return operands  # operador sin coordenadas → sin cambio


# ============================================================
# 2. BOUNDING BOX (hit-test como herramienta V)
# ============================================================

def get_bounding_box(instructions):
    """
    Calcula el bounding box de todos los paths del content stream.
    Retorna (x_min, y_min, x_max, y_max) o None.
    """
    xs, ys = [], []

    for inst in instructions:
        if not hasattr(inst, 'operator'):
            continue
        op = str(inst.operator)
        ops = list(inst.operands)

        try:
            if op == 're' and len(ops) == 4:
                x, y, w, h = [float(o) for o in ops]
                xs += [x, x + w]; ys += [y, y + h]

            elif op in ('m', 'l') and len(ops) == 2:
                xs.append(float(ops[0])); ys.append(float(ops[1]))

            elif op == 'c' and len(ops) == 6:
                for i in range(0, 6, 2):
                    xs.append(float(ops[i])); ys.append(float(ops[i+1]))

            elif op == 'Tm' and len(ops) == 6:
                xs.append(float(ops[4])); ys.append(float(ops[5]))

            elif op == 'Td' and len(ops) == 2:
                xs.append(float(ops[0])); ys.append(float(ops[1]))
        except Exception:
            pass

    if not xs:
        return None
    return (min(xs), min(ys), max(xs), max(ys))


def point_in_bbox(px, py, bbox, margin=5):
    """¿Está el punto (px,py) dentro del bounding box? (hit-test)"""
    x0, y0, x1, y1 = bbox
    return (x0 - margin) <= px <= (x1 + margin) and \
           (y0 - margin) <= py <= (y1 + margin)


# ============================================================
# 3. LEER / ESCRIBIR CONTENT STREAM
# ============================================================

def get_content_stream_instructions(page):
    """
    Extrae y parsea el content stream de una página.
    Maneja tanto /Contents como arrays de streams.
    """
    contents = page.get("/Contents")
    if contents is None:
        return [], None

    # Normalizar: puede ser un objeto directo o un array
    if isinstance(contents, pikepdf.Array):
        # Concatenar todos los streams
        all_bytes = b""
        for ref in contents:
            stream_obj = ref
            all_bytes += stream_obj.read_bytes()
        # Parsear el stream combinado
        instructions = parse_content_stream(all_bytes)
        return instructions, contents
    else:
        stream_obj = contents
        instructions = parse_content_stream(stream_obj)
        return instructions, stream_obj


def write_content_stream(stream_ref, new_instructions):
    """
    Serializa las instrucciones y las escribe de vuelta en el stream.
    pikepdf se encarga de la compresión automáticamente.
    """
    new_bytes = unparse_content_stream(new_instructions)

    if isinstance(stream_ref, pikepdf.Array):
        # Si hay múltiples streams, escribir todo en el primero y vaciar el resto
        first = True
        for ref in stream_ref:
            if first:
                ref.write(new_bytes)
                first = False
            else:
                ref.write(b"")  # vaciar streams adicionales
    else:
        stream_ref.write(new_bytes)


# ============================================================
# 4. API PRINCIPAL
# ============================================================

def move_all_objects(input_path, output_path, dx, dy, page_index=0):
    """
    Mueve TODOS los objetos gráficos de una página en dx, dy puntos PDF.
    (1 punto = 1/72 pulgada; eje Y crece hacia arriba en PDF)
    """
    with pikepdf.open(input_path) as pdf:
        page = pdf.pages[page_index]
        instructions, stream_ref = get_content_stream_instructions(page)

        if not instructions:
            print("No se encontró content stream.")
            return

        bb = get_bounding_box(instructions)
        print(f"Bounding box de la página: {bb}")
        print(f"Total instrucciones: {len(instructions)}")

        new_instructions = []
        for inst in instructions:
            if isinstance(inst, ContentStreamInlineImage):
                new_instructions.append(inst)  # imágenes inline → sin cambio
                continue

            new_ops = translate_instruction(inst, dx, dy)
            new_instructions.append(
                ContentStreamInstruction(new_ops, inst.operator)
            )

        write_content_stream(stream_ref, new_instructions)
        pdf.save(output_path)
        print(f"Guardado: {output_path}")


def move_object_at(input_path, output_path, click_x, click_y, dx, dy, page_index=0):
    """
    Simula la herramienta V de Illustrator:
    - Hace hit-test en (click_x, click_y)
    - Si hay un objeto ahí, lo mueve dx, dy
    - El resto permanece intacto

    NOTA: En coordenadas PDF el origen es abajo-izquierda.
    """
    with pikepdf.open(input_path) as pdf:
        page = pdf.pages[page_index]
        instructions, stream_ref = get_content_stream_instructions(page)

        if not instructions:
            print("No se encontró content stream.")
            return

        # ── Segmentar en sub-paths (grupos de instrucciones por objeto) ──
        segments = segment_by_object(instructions)
        print(f"Objetos detectados en la página: {len(segments)}")

        hit_segment = None
        for i, seg in enumerate(segments):
            bb = get_bounding_box(seg)
            if bb:
                print(f"  Objeto {i}: bbox={bb}")
                if point_in_bbox(click_x, click_y, bb):
                    hit_segment = i
                    print(f"  → HIT en objeto {i}")

        if hit_segment is None:
            print("No se encontró ningún objeto en esa posición.")
            return

        # ── Reconstruir el stream moviendo solo el objeto seleccionado ──
        new_instructions = []
        current = 0
        for i, seg in enumerate(segments):
            for inst in seg:
                if isinstance(inst, ContentStreamInlineImage):
                    new_instructions.append(inst)
                    continue

                if i == hit_segment:
                    new_ops = translate_instruction(inst, dx, dy)
                    new_instructions.append(
                        ContentStreamInstruction(new_ops, inst.operator)
                    )
                else:
                    new_instructions.append(inst)

        write_content_stream(stream_ref, new_instructions)
        pdf.save(output_path)
        print(f"Guardado: {output_path}")


def segment_by_object(instructions):
    """
    Divide el content stream en segmentos lógicos.
    Cada 'q ... Q' (save/restore) es un objeto independiente.
    Si no hay q/Q, separa por operadores de pintado (f, S, B...).
    """
    segments = []
    current = []
    depth = 0

    paint_ops = {'f', 'F', 'S', 's', 'B', 'b', 'f*', 'B*', 'b*', 'n'}

    for inst in instructions:
        if not hasattr(inst, 'operator'):
            current.append(inst)
            continue

        op = str(inst.operator)
        current.append(inst)

        if op == 'q':
            depth += 1
        elif op == 'Q':
            depth -= 1
            if depth == 0:
                segments.append(current[:])
                current = []
        elif op in paint_ops and depth == 0:
            # Sin q/Q: separar por cada operación de pintado
            segments.append(current[:])
            current = []

    if current:
        segments.append(current)

    return segments


# ============================================================
# 5. INSPECCIÓN (utilidad de debug)
# ============================================================

def inspect_pdf(path, page_index=0):
    """Muestra todos los operadores del content stream de una página."""
    with pikepdf.open(path) as pdf:
        page = pdf.pages[page_index]
        instructions, _ = get_content_stream_instructions(page)

        print(f"=== {path} — Página {page_index} ===")
        print(f"Tamaño de página: {page.mediabox}")
        print(f"Total instrucciones: {len(instructions)}\n")

        for i, inst in enumerate(instructions):
            if hasattr(inst, 'operator'):
                op = str(inst.operator)
                ops = [str(o) for o in inst.operands]
                print(f"  [{i:3}]  {' '.join(ops):40s}  {op}")



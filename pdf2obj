"""
Diagnóstico profundo para ver exactamente qué tiene /Resources/Properties
y cómo se relaciona con los OCGs del catálogo.
"""
import pikepdf
from pikepdf import Pdf

def diagnostico_profundo(pdf_path: str):
    pdf  = Pdf.open(pdf_path)
    page = pdf.pages[0]

    print("\n[1] OCGs en el catálogo:")
    try:
        for ref in pdf.Root["/OCProperties"]["/OCGs"]:
            print(f"     type={type(ref)}")
            print(f"     objgen={ref.objgen}")
            print(f"     Name={ref.get('/Name')}")
            print(f"     repr={repr(ref)}")
            print()
    except Exception as e:
        print(f"     Error: {e}")

    print("\n[2] /Resources/Properties de la página:")
    try:
        props = page.obj["/Resources"]["/Properties"]
        print(f"     type(props)={type(props)}")
        for key in props.keys():
            val = props[key]
            print(f"\n     key=/{key}")
            print(f"     type(val)={type(val)}")
            print(f"     repr={repr(val)[:200]}")
            try:
                print(f"     objgen={val.objgen}")
            except Exception as e:
                print(f"     objgen → Error: {e}")
            try:
                print(f"     Name={val.get('/Name')}")
            except Exception as e:
                print(f"     Name → Error: {e}")
    except Exception as e:
        print(f"     Error: {e}")

    print("\n[3] Comparación directa objgen:")
    try:
        ocg_objgens = {}
        for ref in pdf.Root["/OCProperties"]["/OCGs"]:
            ocg_objgens[ref.objgen] = str(ref["/Name"])

        props = page.obj["/Resources"]["/Properties"]
        for key in props.keys():
            val = props[key]
            try:
                og = val.objgen
                match = ocg_objgens.get(og, "SIN MATCH")
                print(f"     /{key} objgen={og} → '{match}'")
            except Exception as e:
                # Puede ser un objeto indirecto — intentar resolverlo
                try:
                    resolved = pdf.get_object(val.objgen)
                    og = val.objgen
                    match = ocg_objgens.get(og, "SIN MATCH")
                    print(f"     /{key} (resolved) objgen={og} → '{match}'")
                except Exception as e2:
                    print(f"     /{key} → no se pudo obtener objgen: {e} / {e2}")
    except Exception as e:
        print(f"     Error: {e}")

    pdf.close()

if __name__ == "__main__":
    import sys
    ruta = sys.argv[1] if len(sys.argv) > 1 else "diseño.pdf"
    diagnostico_profundo(ruta)

import pymupdf
import re

def get_swatches(doc):
    swatches = {}
    for xref in range(1, doc.xref_length()):
        try:
            obj_str = doc.xref_object(xref, compressed=False)
        except:
            continue
        if "/Separation" not in obj_str:
            continue
        match_name = re.search(r'/Separation\s+/([^\s/\]>]+)', obj_str)
        match_c1   = re.search(r'/C1\s*\[([^\]]+)\]', obj_str)
        if match_name and match_c1:
            name = match_name.group(1)
            c1   = [float(v) for v in match_c1.group(1).split()]
            swatches[name] = tuple(c1)
    return swatches


def draw_with_swatch(doc, page, rect, swatch_name, cmyk, tint=1.0):
    c, m, y, k = cmyk

    # 1. Crear el colorspace Separation
    cs_obj = (
        f"[ /Separation /{swatch_name} /DeviceCMYK <<\n"
        f"  /FunctionType 2\n"
        f"  /Domain [ 0 1 ]\n"
        f"  /C0 [ 0 0 0 0 ]\n"
        f"  /C1 [ {c} {m} {y} {k} ]\n"
        f"  /N 1\n"
        f"  /Range [ 0 1 0 1 0 1 0 1 ]\n"
        f">>]"
    )
    cs_xref = doc.get_new_xref()
    doc.update_object(cs_xref, cs_obj)

    # 2. Registrar el colorspace en Resources de la página usando xref_set_key
    #    (más estable que manipular el string del objeto)
    res_name = f"CS{swatch_name}"
    doc.xref_set_key(page.xref, f"Resources/ColorSpace/{res_name}", f"{cs_xref} 0 R")

    # 3. Crear el content stream  ← CORRECCIÓN: update_object primero, luego new=True
    x0, y0, x1, y1 = rect.x0, rect.y0, rect.x1, rect.y1
    h = page.rect.height

    stream = (
        f"q\n"
        f"/{res_name} cs\n"
        f"{tint} scn\n"
        f"/{res_name} CS\n"
        f"{tint} SCN\n"
        f"{x0} {h - y1} {x1 - x0} {y1 - y0} re\n"
        f"f\n"
        f"Q\n"
    ).encode()

    new_xref = doc.get_new_xref()
    doc.update_object(new_xref, "<<>>")        # ← inicializar como dict PDF
    doc.update_stream(new_xref, stream, new=True)  # ← new=True convierte a stream

    # 4. Agregar el stream a los contents de la página
    contents = page.get_contents()
    contents.append(new_xref)
    page.set_contents(contents)


# ── USO ──────────────────────────────────────────────────────────────────────

doc = pymupdf.open("tu_archivo.pdf")
swatches = get_swatches(doc)
print("Swatches:", swatches)

page = doc[0]
draw_with_swatch(
    doc=doc,
    page=page,
    rect=pymupdf.Rect(50, 50, 200, 150),
    swatch_name="LASER",
    cmyk=swatches["LASER"],
    tint=1.0
)

doc.save("output.pdf", garbage=4, deflate=True)

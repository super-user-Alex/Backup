"""
debug_ocg.py
============
Diagnóstico: muestra exactamente cómo están escritos los OCGs
en el content stream de tu PDF.

Uso:
    python debug_ocg.py tu_archivo.pdf

Pega el output completo para que podamos ver el formato exacto.
"""

import sys
import re
import pikepdf
from pikepdf import Pdf


def debug_pdf(path: str):
    pdf = Pdf.open(path)

    # ── 1. OCGs declarados ───────────────────────────────────────────────
    print("=" * 60)
    print("1. OCGs en /OCProperties")
    print("=" * 60)
    try:
        for ref in pdf.Root["/OCProperties"]["/OCGs"]:
            print(f"   Name={ref.get('/Name')!r}  ref={ref.objgen}")
    except Exception as e:
        print(f"   ERROR: {e}")

    # ── 2. Recursos por página ───────────────────────────────────────────
    print()
    print("=" * 60)
    print("2. /Resources/Properties por página")
    print("=" * 60)
    for pnum, page in enumerate(pdf.pages):
        try:
            props = page.obj["/Resources"]["/Properties"]
            print(f"  Página {pnum+1}:")
            for key, ref in props.items():
                name = ref.get("/Name")
                print(f"    clave='{key}'  Name={name!r}  ref={ref.objgen}")
        except (KeyError, AttributeError):
            print(f"  Página {pnum+1}: sin /Properties")

    # ── 3. Content stream bruto (primeros 4000 bytes) ────────────────────
    print()
    print("=" * 60)
    print("3. Content stream BRUTO (primeros 4000 bytes de cada página)")
    print("=" * 60)
    for pnum, page in enumerate(pdf.pages):
        contents = page.obj.get("/Contents")
        if contents is None:
            print(f"  Página {pnum+1}: sin /Contents")
            continue

        if isinstance(contents, pikepdf.Array):
            raw = b" ".join(item.read_bytes() for item in contents)
        else:
            raw = contents.read_bytes()

        print(f"\n--- Página {pnum+1} ({len(raw)} bytes) ---")
        print(raw[:4000].decode("latin-1", errors="replace"))

    # ── 4. Extraer todas las líneas con BDC / EMC ────────────────────────
    print()
    print("=" * 60)
    print("4. Líneas que contienen BDC o EMC")
    print("=" * 60)
    for pnum, page in enumerate(pdf.pages):
        contents = page.obj.get("/Contents")
        if contents is None:
            continue
        if isinstance(contents, pikepdf.Array):
            raw = b" ".join(item.read_bytes() for item in contents)
        else:
            raw = contents.read_bytes()

        lines = raw.decode("latin-1", errors="replace").splitlines()
        print(f"\n  Página {pnum+1}:")
        for i, line in enumerate(lines):
            if "BDC" in line or "EMC" in line or "BMC" in line:
                print(f"    L{i+1:4d}: {line!r}")

    print()
    print("=" * 60)
    print("FIN DEL DIAGNÓSTICO — pega todo el output")
    print("=" * 60)


if __name__ == "__main__":
    if len(sys.argv) < 2:
        print("Uso: python debug_ocg.py tu_archivo.pdf")
        sys.exit(1)
    debug_pdf(sys.argv[1])

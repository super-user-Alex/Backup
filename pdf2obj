"""
ocg_to_pages_pypdf.py
---------------------
Toma cada Optional Content Group (OCG / capa) de un PDF
y lo coloca en una página separada del documento de salida.

Solo requiere pypdf:
    pip install pypdf

Uso:
    python ocg_to_pages_pypdf.py input.pdf output.pdf [opciones]

Opciones:
    --no-common    Excluir contenido sin OCG (común) de cada página.
    --verbose, -v  Mostrar detalles del proceso.
"""

import sys
import argparse
from pypdf import PdfReader, PdfWriter
from pypdf.generic import ContentStream, NameObject, IndirectObject


# ---------------------------------------------------------------------------
# Inspección de OCGs
# ---------------------------------------------------------------------------

def get_document_ocgs(reader: PdfReader) -> list[dict]:
    """
    Retorna lista de dicts:
        [{'name': str, 'idnum': int}, ...]
    con todos los OCGs del catálogo del PDF.
    """
    root = reader.trailer['/Root']
    if '/OCProperties' not in root:
        return []

    result = []
    for ref in root['/OCProperties']['/OCGs']:
        obj = ref.get_object()
        result.append({'name': str(obj['/Name']), 'idnum': ref.idnum})
    return result


def get_prop_map(page, root) -> dict:
    """
    Devuelve { '/PropName': idnum } para cada OCG referenciado
    en Resources/Properties de la página.
    """
    prop_map = {}
    try:
        props = page['/Resources']['/Properties']
    except KeyError:
        return prop_map

    for key in props:
        obj = props[key]
        if isinstance(obj, IndirectObject):
            obj = obj.get_object()
        if obj.get('/Type') == NameObject('/OCG'):
            # Buscar el idnum en los OCGs del catálogo
            for ref in root['/OCProperties']['/OCGs']:
                if str(ref.get_object()['/Name']) == str(obj['/Name']):
                    prop_map[key] = ref.idnum
                    break
    return prop_map


# ---------------------------------------------------------------------------
# Filtrado del content stream
# ---------------------------------------------------------------------------

def _visible(stack: list, target: int, include_common: bool) -> bool:
    """¿Debe incluirse la instrucción actual según el stack?"""
    if not stack:
        return include_common
    for frame in reversed(stack):
        if frame[0] == 'oc':
            return frame[1] == target
    return include_common


def filter_ops(ops: list,
               prop_map: dict,
               target_idnum: int,
               include_common: bool = True) -> list:
    """
    Filtra las operaciones del content stream conservando solo:
      - El bloque BDC/EMC del OCG objetivo
      - Si include_common: instrucciones fuera de cualquier OC
    """
    result = []
    stack = []  # ('oc', idnum) | ('other',)

    for operands, operator in ops:
        op = operator if isinstance(operator, str) else operator.decode()

        if op in ('BDC', 'BMC'):
            is_oc = len(operands) >= 2 and str(operands[0]) == '/OC'
            if is_oc:
                idnum = prop_map.get(str(operands[1]))
                stack.append(('oc', idnum))
                if idnum == target_idnum:
                    result.append((operands, operator))
            else:
                stack.append(('other',))
                if _visible(stack, target_idnum, include_common):
                    result.append((operands, operator))

        elif op == 'EMC':
            if not stack:
                result.append((operands, operator))
                continue
            top = stack[-1]
            was_visible = _visible(stack, target_idnum, include_common)
            stack.pop()
            if top[0] == 'oc':
                if top[1] == target_idnum:
                    result.append((operands, operator))
            else:
                if was_visible:
                    result.append((operands, operator))

        else:
            if _visible(stack, target_idnum, include_common):
                result.append((operands, operator))

    return result


# ---------------------------------------------------------------------------
# Función principal
# ---------------------------------------------------------------------------

def ocg_to_pages(input_path: str,
                 output_path: str,
                 include_common: bool = True,
                 verbose: bool = False) -> bool:
    """
    Lee input_path y genera una página por OCG en output_path.
    """
    # Leer OCGs del PDF una vez (solo para inspeccion)
    probe = PdfReader(input_path)
    ocgs = get_document_ocgs(probe)

    if not ocgs:
        print("El PDF no contiene Optional Content Groups (capas).")
        return False

    if verbose:
        print(f"Entrada: {input_path}")
        print(f"OCGs encontrados ({len(ocgs)}):")
        for ocg in ocgs:
            print(f"  - {ocg['name']}  (idnum={ocg['idnum']})")
        print()

    writer = PdfWriter()
    total = 0

    for ocg in ocgs:
        name   = ocg['name']
        idnum  = ocg['idnum']

        if verbose:
            print(f"Procesando: {name}")

        # Abrir una copia fresca del PDF por cada OCG
        # (evita que replace_contents de una iteracion afecte la siguiente)
        reader = PdfReader(input_path)
        root   = reader.trailer['/Root']

        for pnum, page in enumerate(reader.pages):
            prop_map = get_prop_map(page, root)
            cs       = page.get_contents()
            ops      = list(cs.operations)
            filtered = filter_ops(ops, prop_map, idnum, include_common)

            cs.operations = filtered
            page.replace_contents(cs)
            writer.add_page(page)
            total += 1

            if verbose:
                print(f"  pagina fuente {pnum+1} -> pagina output {total}")

    # Eliminar OCProperties del output (el contenido ya esta separado)
    if '/OCProperties' in writer._root_object:
        del writer._root_object['/OCProperties']

    with open(output_path, 'wb') as f:
        writer.write(f)

    print(f"\nGuardado: {output_path}")
    print(f"  OCGs          : {len(ocgs)}")
    print(f"  Paginas fuente: {len(probe.pages)}")
    print(f"  Paginas output: {total}")
    return True


# ---------------------------------------------------------------------------
# CLI
# ---------------------------------------------------------------------------

def main():
    parser = argparse.ArgumentParser(
        description="Extrae cada OCG/capa de un PDF a una pagina separada.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Ejemplos:
  python ocg_to_pages_pypdf.py planos.pdf salida.pdf
  python ocg_to_pages_pypdf.py planos.pdf salida.pdf --no-common --verbose
        """
    )
    parser.add_argument("input",  help="PDF de entrada con OCGs")
    parser.add_argument("output", help="PDF de salida")
    parser.add_argument(
        "--no-common",
        action="store_true",
        help="Excluir contenido sin capa de cada pagina."
    )
    parser.add_argument("--verbose", "-v", action="store_true")
    args = parser.parse_args()

    ok = ocg_to_pages(
        input_path=args.input,
        output_path=args.output,
        include_common=not args.no_common,
        verbose=args.verbose,
    )
    sys.exit(0 if ok else 1)


if __name__ == '__main__':
    main()

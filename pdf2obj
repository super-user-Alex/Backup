"""
SOLUCIÓN: mover_multiples_ocgs
==============================
Permite mover /MC0, /MC1, /MC2 (cualquier combinación) de forma
INDEPENDIENTE, sin necesidad de encadenar llamadas.

Pega esta función al final de tu archivo mover_pdf_directo.py
(o en un archivo aparte que importe las funciones base).

Problema original
-----------------
mover_ocg_directo() abre el PDF original cada vez → si quieres
mover MC0 + MC1 + MC2, hay que:
    1. mover_ocg_directo(PDF,    "MC0", dx0, dy0, "tmp1.pdf")
    2. mover_ocg_directo("tmp1", "MC1", dx1, dy1, "tmp2.pdf")  # depende de tmp1
    3. mover_ocg_directo("tmp2", "MC2", dx2, dy2, "final.pdf") # depende de tmp2

Solución
--------
mover_multiples_ocgs() aplica TODOS los movimientos al mismo PDF
abierto en memoria y lo guarda una sola vez → sin dependencias.
"""

# ──────────────────────────────────────────────────────────────────────────────
# Asegúrate de tener importadas las funciones base de mover_pdf_directo.py:
#   _ocg_objgen_a_nombre, _nombre_ocg_a_alias, _modificar_stream
# Si usas este archivo de forma autónoma, importa así:
#
#   from mover_pdf_directo import (
#       _ocg_objgen_a_nombre, _nombre_ocg_a_alias, _modificar_stream
#   )
# ──────────────────────────────────────────────────────────────────────────────

import pikepdf
from pikepdf import Pdf


def mover_multiples_ocgs(
    pdf_path: str,
    movimientos: dict,          # {nombre_ocg: (dx, dy)}
    output_pdf: str = "resultado.pdf"
) -> str:
    """
    Mueve varios OCGs en una sola pasada sobre el mismo PDF.
    No hay dependencias entre capas: puedes mover MC0, MC1 y MC2
    en cualquier orden o sólo algunos.

    Args:
        pdf_path   : Ruta al PDF de entrada.
        movimientos: Diccionario  {nombre_ocg: (dx, dy)}
                     Ejemplo:
                         {
                             "MC0": (100, -50),
                             "MC1": (0,   30),
                             "MC2": (-20,  0),
                         }
        output_pdf : PDF de salida.

    Returns:
        Ruta del PDF guardado.

    Ejemplo de uso
    --------------
    mover_multiples_ocgs(
        pdf_path   = "diseño.pdf",
        movimientos = {
            "MC0": (100, -50),   # 100 pts derecha, 50 pts abajo
            "MC1": (0,    30),   # solo vertical
            # MC2 no se mueve → simplemente no lo incluyas
        },
        output_pdf = "resultado.pdf"
    )
    """
    pdf   = Pdf.open(pdf_path)
    ogmap = _ocg_objgen_a_nombre(pdf)

    # Validar que todos los OCGs pedidos existen
    nombres_disponibles = list(ogmap.values())
    for nombre in movimientos:
        if nombre not in nombres_disponibles:
            pdf.close()
            raise ValueError(
                f"OCG '{nombre}' no encontrado.\n"
                f"Disponibles: {nombres_disponibles}"
            )

    streams_modificados = 0

    for i, page in enumerate(pdf.pages):
        # Mapa nombre_ocg → [alias, ...] para esta página
        nombre_a_aliases = _nombre_ocg_a_alias(page.obj, ogmap)

        contenido = page.obj.get("/Contents")
        if contenido is None:
            continue

        # Leer el stream (puede ser un objeto único o un Array)
        if isinstance(contenido, pikepdf.Array):
            objetos_stream = list(contenido)
        else:
            objetos_stream = [contenido]

        for stream_obj in objetos_stream:
            raw = stream_obj.read_bytes()
            mod = raw

            # Aplicar cada movimiento pedido al mismo bloque de bytes
            for nombre_ocg, (dx, dy) in movimientos.items():
                aliases = nombre_a_aliases.get(nombre_ocg, [])
                if not aliases:
                    continue
                mod = _modificar_stream(mod, aliases, dx, dy)

            if mod != raw:
                stream_obj.write(mod)
                streams_modificados += 1
                print(f"  Página {i+1}: stream modificado con {list(movimientos.keys())}")

    if streams_modificados == 0:
        print("  ADVERTENCIA: no se modificó ningún stream.")
        print(f"  Ejecuta analizar_ocgs_en_stream('{pdf_path}') para diagnosticar.")
    else:
        print(f"  Total streams modificados: {streams_modificados}")

    pdf.save(output_pdf)
    pdf.close()
    print(f"\n  Guardado: {output_pdf}")
    return output_pdf


# ──────────────────────────────────────────────────────────────────────────────
# VARIANTE: mover_multiples_ocgs_absoluto
# Igual que mover_ocg_a_posicion pero para N capas a la vez.
# ──────────────────────────────────────────────────────────────────────────────

import os
import tempfile
import fitz


def mover_multiples_ocgs_absoluto(
    pdf_path: str,
    posiciones: dict,           # {nombre_ocg: (nuevo_x, nuevo_y)}  top-down
    output_pdf: str = "resultado.pdf"
) -> str:
    """
    Mueve varios OCGs a posiciones absolutas (coordenadas top-down
    como Illustrator) en una sola pasada.

    Args:
        posiciones: {nombre_ocg: (nuevo_x, nuevo_y)}
                    Ejemplo:
                        {
                            "MC0": (400, 200),
                            "MC1": (100,  50),
                        }
    """
    pdf    = Pdf.open(pdf_path)
    ogmap  = _ocg_objgen_a_nombre(pdf)
    estados_orig = _leer_estados_originales(pdf)

    movimientos = {}

    for nombre_ocg, (nuevo_x, nuevo_y) in posiciones.items():
        if nombre_ocg not in ogmap.values():
            pdf.close()
            raise ValueError(
                f"OCG '{nombre_ocg}' no encontrado.\n"
                f"Disponibles: {list(ogmap.values())}"
            )

        # Obtener posición actual con fitz
        _encender_solo(pdf, nombre_ocg)
        tmp = tempfile.NamedTemporaryFile(suffix=".pdf", delete=False)
        tmp.close()
        pdf.save(tmp.name)
        _restaurar_estados(pdf, estados_orig)

        doc   = fitz.open(tmp.name)
        paths = doc[0].get_drawings()
        doc.close()
        os.unlink(tmp.name)

        if not paths:
            print(f"  AVISO: '{nombre_ocg}' no tiene elementos medibles, se omite.")
            continue

        x0_actual = min(p["rect"].x0 for p in paths)
        y0_actual = min(p["rect"].y0 for p in paths)

        dx =  nuevo_x - x0_actual
        dy = -(nuevo_y - y0_actual)   # invertir Y (PDF: bottom-up)

        print(f"  '{nombre_ocg}' pos actual ({x0_actual:.1f}, {y0_actual:.1f})"
              f" → destino ({nuevo_x:.1f}, {nuevo_y:.1f})"
              f"  cm: dx={dx:.1f}, dy={dy:.1f}")

        movimientos[nombre_ocg] = (dx, dy)

    pdf.close()

    return mover_multiples_ocgs(pdf_path, movimientos, output_pdf)



"""
ocg_to_pages.py
---------------
Toma cada Optional Content Group (OCG / capa) de un PDF
y lo coloca en una página separada del documento de salida.

Solo requiere pikepdf:
    pip install pikepdf

Uso:
    python ocg_to_pages.py input.pdf output.pdf [opciones]

Opciones:
    --no-common    Excluir contenido sin OCG de cada página.
    --verbose, -v  Mostrar detalles del proceso.
"""

import sys
import io
import argparse
import pikepdf
from pikepdf import (
    Pdf, Page, Dictionary, Array, Name, String, Stream,
    parse_content_stream, unparse_content_stream,
)


# ---------------------------------------------------------------------------
# Inspección de OCGs
# ---------------------------------------------------------------------------

def get_document_ocgs(pdf):
    """
    Retorna lista de dicts:
        [{'name': str, 'objgen': tuple}, ...]
    ordenada según /OCProperties/OCGs del PDF.
    """
    if '/OCProperties' not in pdf.Root:
        return []

    result = []
    for ref in pdf.Root.OCProperties.OCGs:
        name = str(ref.get('/Name', String('')))
        result.append({'name': name, 'objgen': ref.objgen})
    return result


def get_prop_map(page_obj):
    """
    Devuelve { '/PropName': objgen_tuple } para cada OCG
    referenciado en Resources/Properties de la página.
    """
    prop_map = {}
    try:
        props = page_obj.Resources.Properties
        for key in props.keys():
            ocg_obj = props[key]
            if '/Type' in ocg_obj and str(ocg_obj.Type) == '/OCG':
                prop_map[key] = ocg_obj.objgen
    except AttributeError:
        pass
    return prop_map


# ---------------------------------------------------------------------------
# Filtrado del content stream
# ---------------------------------------------------------------------------

def _visible(stack, target, include_common):
    """¿Debe incluirse una instrucción dado el stack actual?"""
    if not stack:
        return include_common
    for frame in reversed(stack):
        if frame[0] == 'oc':
            return frame[1] == target
    return include_common


def filter_stream(instructions, prop_map, target_objgen, include_common):
    """
    Filtra las instrucciones dejando solo el contenido del target_objgen
    (y opcionalmente el contenido sin OCG).
    """
    result = []
    stack = []  # ('oc', objgen) | ('other',)

    for instr in instructions:
        op = str(instr.operator)
        ops = list(instr.operands)

        if op in ('BDC', 'BMC'):
            is_oc = len(ops) >= 2 and str(ops[0]) == '/OC'
            if is_oc:
                objgen = prop_map.get(str(ops[1]))
                stack.append(('oc', objgen))
                if objgen == target_objgen:
                    result.append(instr)
            else:
                stack.append(('other',))
                if _visible(stack, target_objgen, include_common):
                    result.append(instr)

        elif op == 'EMC':
            if not stack:
                result.append(instr)
                continue
            top = stack[-1]
            was_visible = _visible(stack, target_objgen, include_common)
            stack.pop()
            if top[0] == 'oc':
                if top[1] == target_objgen:
                    result.append(instr)
            else:
                if was_visible:
                    result.append(instr)
        else:
            if _visible(stack, target_objgen, include_common):
                result.append(instr)

    return result


# ---------------------------------------------------------------------------
# Construcción de la página filtrada
# ---------------------------------------------------------------------------

def make_filtered_page(src_bytes, src_page_num, target_pdf, target_objgen, include_common):
    """
    Abre una copia fresca del PDF fuente (para evitar el cacheo de copy_foreign),
    filtra el content stream y retorna una Page lista para el PDF destino.
    """
    fresh = Pdf.open(io.BytesIO(src_bytes))
    src_page = fresh.pages[src_page_num]
    prop_map = get_prop_map(src_page.obj)

    instructions = parse_content_stream(src_page)
    filtered = filter_stream(instructions, prop_map, target_objgen, include_common)
    stream_data = unparse_content_stream(filtered)

    new_page_obj = target_pdf.copy_foreign(src_page.obj)
    new_page_obj['/Contents'] = target_pdf.make_indirect(
        Stream(target_pdf, stream_data)
    )

    fresh.close()
    return Page(new_page_obj)


# ---------------------------------------------------------------------------
# Función principal
# ---------------------------------------------------------------------------

def ocg_to_pages(input_path, output_path, include_common=True, verbose=False):
    """
    Lee input_path, crea una página por cada OCG en output_path.
    """
    with open(input_path, 'rb') as f:
        src_bytes = f.read()

    src = Pdf.open(io.BytesIO(src_bytes))
    ocgs = get_document_ocgs(src)
    num_src_pages = len(src.pages)
    src.close()

    if not ocgs:
        print("El PDF no contiene Optional Content Groups (capas).")
        return False

    if verbose:
        print(f"Entrada : {input_path}")
        print(f"OCGs encontrados ({len(ocgs)}):")
        for ocg in ocgs:
            print(f"  - {ocg['name']}  (objgen={ocg['objgen']})")
        print()

    out = Pdf.new()
    total = 0

    for ocg in ocgs:
        name   = ocg['name']
        objgen = ocg['objgen']
        if verbose:
            print(f"Procesando: {name}")

        for pnum in range(num_src_pages):
            if verbose:
                print(f"  pagina fuente {pnum+1} -> pagina output {total+1}")
            page = make_filtered_page(src_bytes, pnum, out, objgen, include_common)
            out.pages.append(page)
            total += 1

    if '/OCProperties' in out.Root:
        del out.Root['/OCProperties']

    out.save(output_path, fix_metadata_version=True)

    print(f"\nGuardado: {output_path}")
    print(f"  OCGs         : {len(ocgs)}")
    print(f"  Paginas fuente: {num_src_pages}")
    print(f"  Paginas output: {total}")
    return True


# ---------------------------------------------------------------------------
# CLI
# ---------------------------------------------------------------------------

def main():
    parser = argparse.ArgumentParser(
        description="Extrae cada OCG/capa de un PDF a una pagina separada."
    )
    parser.add_argument("input",  help="PDF de entrada")
    parser.add_argument("output", help="PDF de salida")
    parser.add_argument("--no-common", action="store_true",
                        help="Excluir contenido sin capa de cada pagina.")
    parser.add_argument("--verbose", "-v", action="store_true")
    args = parser.parse_args()

    ok = ocg_to_pages(args.input, args.output,
                      include_common=not args.no_common,
                      verbose=args.verbose)
    sys.exit(0 if ok else 1)


if __name__ == '__main__':
    main()

"""
mover_pdf_directo.py
====================
Mueve elementos de un PDF de Illustrator manipulando el content stream
directamente. Sin conversión a SVG ni rasterización.

Cómo funciona internamente:
    Un PDF tiene un "content stream" con operadores gráficos. Los OCGs
    están envueltos en marcadores BDC/EMC:

        /OC /NombreCapa BDC    <- inicio del OCG
            ... elementos ...
        EMC                    <- fin del OCG

    Para mover esos elementos se inserta el operador `cm`
    (concatenate matrix) justo antes del BDC:

        q
        1 0 0 1 dx dy cm       <- traslación pura
        /OC /NombreCapa BDC
            ... elementos ...
        EMC
        Q                      <- restaurar estado gráfico

Dependencias:
    pip install pikepdf pymupdf
"""

import re
import fitz
import pikepdf
from pikepdf import Pdf, Name, Array


# ─────────────────────────────────────────────────────────────
# HELPERS — control de visibilidad OCG via pikepdf
# Reemplaza fitz.set_ocg() removido en PyMuPDF >= 1.23
# ─────────────────────────────────────────────────────────────

def _obtener_refs_ocg(pdf: Pdf) -> dict:
    """Devuelve {nombre: objeto_ocg} desde /OCProperties del catálogo."""
    refs = {}
    try:
        for ocg_ref in pdf.Root["/OCProperties"]["/OCGs"]:
            refs[str(ocg_ref["/Name"])] = ocg_ref
    except (KeyError, AttributeError):
        pass
    return refs


def _leer_estados_originales(pdf: Pdf) -> dict:
    """Lee visibilidad actual de cada OCG. Devuelve {nombre: bool}."""
    estados = {}
    try:
        oc_props = pdf.Root["/OCProperties"]
        off_objgens = set()
        if "/OFF" in oc_props["/D"]:
            for r in oc_props["/D"]["/OFF"]:
                if hasattr(r, "objgen"):
                    off_objgens.add(r.objgen)
        for ref in oc_props["/OCGs"]:
            nombre = str(ref["/Name"])
            estados[nombre] = ref.objgen not in off_objgens
    except (KeyError, AttributeError):
        pass
    return estados


def _apagar_todos_ocgs(pdf: Pdf):
    """Oculta todos los OCGs modificando /OCProperties/D/OFF."""
    try:
        oc_props = pdf.Root["/OCProperties"]
        oc_props["/D"]["/OFF"] = Array(list(oc_props["/OCGs"]))
    except (KeyError, AttributeError):
        pass


def _encender_solo(pdf: Pdf, nombre_ocg: str):
    """Oculta todo y enciende solo el OCG indicado."""
    _apagar_todos_ocgs(pdf)
    try:
        oc_props = pdf.Root["/OCProperties"]
        off_list = []
        for ref in oc_props["/OCGs"]:
            if str(ref["/Name"]) != nombre_ocg:
                off_list.append(ref)
        oc_props["/D"]["/OFF"] = Array(off_list)
    except (KeyError, AttributeError):
        pass


def _restaurar_estados(pdf: Pdf, estados: dict):
    """Restaura la visibilidad original de todos los OCGs."""
    try:
        oc_props = pdf.Root["/OCProperties"]
        off_list = [
            ref for ref in oc_props["/OCGs"]
            if not estados.get(str(ref["/Name"]), True)
        ]
        oc_props["/D"]["/OFF"] = Array(off_list)
    except (KeyError, AttributeError):
        pass


# ─────────────────────────────────────────────────────────────
# 1. INSPECCIÓN
# ─────────────────────────────────────────────────────────────

def listar_ocgs(pdf_path: str) -> dict:
    """
    Lista los OCGs (capas) del PDF con nombre y estado visible/oculto.

    Returns:
        {nombre: visible(bool)}
    """
    pdf = Pdf.open(pdf_path)
    refs = _obtener_refs_ocg(pdf)

    if not refs:
        print("  El PDF no tiene OCGs.")
        print("  En Illustrator: Guardar como PDF > 'Crear capas de Acrobat'")
        pdf.close()
        return {}

    estados = _leer_estados_originales(pdf)

    print(f"\n{'=' * 50}")
    print(f"  PDF: {pdf_path}")
    print(f"  OCGs encontrados: {len(refs)}")
    print(f"{'=' * 50}")
    for nombre in refs:
        visible = estados.get(nombre, True)
        icono = "ON " if visible else "OFF"
        print(f"  [{icono}]  {nombre}")
    print()

    pdf.close()
    return estados


def analizar_ocgs_en_stream(pdf_path: str) -> list:
    """
    Inspecciona el content stream y muestra los OCGs con su nombre
    exacto tal como aparecen internamente (puede diferir del nombre visible).
    """
    pdf = Pdf.open(pdf_path)
    page = pdf.pages[0]

    contenido = page.obj.get("/Contents")
    if isinstance(contenido, pikepdf.Array):
        raw = b"".join(stream.read_bytes() for stream in contenido)
    else:
        raw = contenido.read_bytes()

    patron = rb'/OC\s+/(\S+)\s+BDC'
    encontrados = re.findall(patron, raw)

    print(f"\n{'=' * 50}")
    print("  OCGs en el content stream (nombre interno):")
    print(f"{'=' * 50}")
    nombres = []
    for nombre in sorted(set(encontrados)):
        conteo = encontrados.count(nombre)
        decoded = nombre.decode("utf-8", errors="replace")
        print(f"  /{decoded}  ({conteo} bloque{'s' if conteo > 1 else ''})")
        nombres.append(decoded)
    print()

    pdf.close()
    return nombres


def analizar_estructura_pdf(pdf_path: str) -> dict:
    """
    Muestra posición y tamaño de cada OCG usando get_drawings() de PyMuPDF.
    Guarda el PDF modificado temporalmente para aislar cada capa.
    """
    import tempfile, os

    pdf  = Pdf.open(pdf_path)
    refs = _obtener_refs_ocg(pdf)

    if not refs:
        print("  El PDF no tiene OCGs.")
        pdf.close()
        return {}

    estados_orig = _leer_estados_originales(pdf)
    estructura = {}

    print(f"\n{'=' * 55}")
    print(f"  Estructura: {pdf_path}")
    print(f"{'=' * 55}")

    for nombre in refs:
        # Aislar este OCG y guardar en archivo temporal
        _encender_solo(pdf, nombre)

        with tempfile.NamedTemporaryFile(suffix=".pdf", delete=False) as tmp:
            tmp_path = tmp.name
        pdf.save(tmp_path)

        # Medir con PyMuPDF sobre el temporal
        doc  = fitz.open(tmp_path)
        page = doc[0]
        paths = page.get_drawings()
        doc.close()
        os.unlink(tmp_path)

        if paths:
            x0 = min(p["rect"].x0 for p in paths)
            y0 = min(p["rect"].y0 for p in paths)
            x1 = max(p["rect"].x1 for p in paths)
            y1 = max(p["rect"].y1 for p in paths)
            bbox = (round(x0,2), round(y0,2), round(x1,2), round(y1,2))
            w, h = round(x1-x0,1), round(y1-y0,1)
        else:
            bbox = None
            w = h = 0

        estructura[nombre] = {"bbox": bbox, "num_elementos": len(paths)}

        visible = estados_orig.get(nombre, True)
        print(f"\n  OCG: '{nombre}'  [{'ON' if visible else 'OFF'}]")
        print(f"    Elementos : {len(paths)}")
        if bbox:
            print(f"    Posicion  : ({bbox[0]}, {bbox[1]})")
            print(f"    Tamano    : {w} x {h} pts")
        else:
            print(f"    Sin elementos vectoriales detectados")

    _restaurar_estados(pdf, estados_orig)
    pdf.close()
    print()
    return estructura


# ─────────────────────────────────────────────────────────────
# 2. MANIPULACIÓN DEL CONTENT STREAM
# ─────────────────────────────────────────────────────────────

def _traducir_bytes_stream(stream_bytes: bytes, nombre_ocg: str,
                           dx: float, dy: float) -> bytes:
    """
    Envuelve cada bloque BDC/EMC del OCG con q...cm...Q.

    Estrategia línea a línea:
      - Al detectar /OC /NombreOCG BDC  -> insertar  q  +  1 0 0 1 dx dy cm
      - Al detectar EMC (cerrando el OCG activo) -> insertar Q
    """
    nombre_bytes = nombre_ocg.encode()
    patron_bdc   = re.compile(
        rb'(/OC\s+/' + re.escape(nombre_bytes) + rb'\s+BDC)'
    )

    translate_in  = f"q\n1 0 0 1 {dx} {dy} cm\n".encode()
    translate_out = b"Q\n"

    output   = []
    en_ocg   = 0   # profundidad del OCG que nos interesa

    for linea in stream_bytes.split(b"\n"):
        stripped = linea.strip()

        if patron_bdc.search(stripped):
            output.append(translate_in)
            output.append(linea)
            en_ocg += 1

        elif stripped == b"EMC" and en_ocg > 0:
            output.append(linea)
            output.append(translate_out)
            en_ocg -= 1

        else:
            output.append(linea)

    return b"\n".join(output)


def _modificar_stream_objeto(stream_obj, nombre_ocg: str,
                              dx: float, dy: float):
    """Lee, modifica y reescribe un stream pikepdf."""
    try:
        raw        = stream_obj.read_bytes()
        modificado = _traducir_bytes_stream(raw, nombre_ocg, dx, dy)
        stream_obj.write(modificado)
    except Exception as e:
        print(f"  Advertencia al modificar stream: {e}")


# ─────────────────────────────────────────────────────────────
# 3. FUNCIONES PRINCIPALES
# ─────────────────────────────────────────────────────────────

def mover_ocg_directo(pdf_path: str, nombre_ocg: str,
                      dx: float, dy: float,
                      output_pdf: str = "resultado.pdf") -> str:
    """
    Mueve un OCG por desplazamiento relativo (dx, dy) en puntos PDF.

    Args:
        pdf_path   : PDF de Illustrator con OCGs.
        nombre_ocg : Nombre del OCG tal como aparece en analizar_ocgs_en_stream().
        dx         : Desplazamiento horizontal (positivo = derecha).
        dy         : Desplazamiento vertical en coords PDF (positivo = arriba).
                     Para mover hacia ABAJO usa dy negativo.
        output_pdf : Archivo PDF resultante.
    """
    pdf = Pdf.open(pdf_path)

    for i, page in enumerate(pdf.pages):
        contenido = page.obj.get("/Contents")
        if contenido is None:
            continue
        if isinstance(contenido, pikepdf.Array):
            for stream_obj in contenido:
                _modificar_stream_objeto(stream_obj, nombre_ocg, dx, dy)
        else:
            _modificar_stream_objeto(contenido, nombre_ocg, dx, dy)
        print(f"  Pagina {i+1}: OCG '{nombre_ocg}' procesado  (dx={dx}, dy={dy})")

    pdf.save(output_pdf)
    pdf.close()
    print(f"\n  Guardado en: {output_pdf}  (PDF nativo, sin rasterizar)")
    return output_pdf


def mover_ocg_a_posicion(pdf_path: str, nombre_ocg: str,
                          nuevo_x: float, nuevo_y: float,
                          output_pdf: str = "resultado.pdf") -> str:
    """
    Mueve un OCG a una posición absoluta calculando dx/dy automáticamente.

    Args:
        pdf_path   : PDF de Illustrator con OCGs.
        nombre_ocg : Nombre del OCG.
        nuevo_x    : X destino en pts (desde borde izquierdo).
        nuevo_y    : Y destino en pts (desde borde SUPERIOR, como Illustrator).
        output_pdf : Archivo PDF resultante.
    """
    import tempfile, os

    # Aislar el OCG para medir su posición actual
    pdf    = Pdf.open(pdf_path)
    refs   = _obtener_refs_ocg(pdf)
    estados_orig = _leer_estados_originales(pdf)

    if nombre_ocg not in refs:
        pdf.close()
        raise ValueError(
            f"OCG '{nombre_ocg}' no encontrado.\n"
            f"Disponibles: {list(refs.keys())}"
        )

    _encender_solo(pdf, nombre_ocg)

    with tempfile.NamedTemporaryFile(suffix=".pdf", delete=False) as tmp:
        tmp_path = tmp.name
    pdf.save(tmp_path)
    _restaurar_estados(pdf, estados_orig)
    pdf.close()

    # Medir con PyMuPDF (coordenadas top-down)
    doc    = fitz.open(tmp_path)
    page   = doc[0]
    paths  = page.get_drawings()
    altura = page.rect.height
    doc.close()
    os.unlink(tmp_path)

    if not paths:
        raise ValueError(f"OCG '{nombre_ocg}' no tiene elementos medibles.")

    x0_actual = min(p["rect"].x0 for p in paths)
    y0_actual = min(p["rect"].y0 for p in paths)   # top-down PyMuPDF

    # Convertir destino de top-down a PDF bottom-up para el operador cm
    # PyMuPDF y el eje Y del usuario: Y=0 arriba
    # PDF content stream: Y=0 abajo  →  dy = -(nuevo_y - y0_actual)
    dx = nuevo_x - x0_actual
    dy = -(nuevo_y - y0_actual)

    print(f"\n  Posicion actual : x={x0_actual:.1f}, y={y0_actual:.1f} pts (top-down)")
    print(f"  Posicion destino: x={nuevo_x:.1f},  y={nuevo_y:.1f} pts (top-down)")
    print(f"  Desplazamiento  : dx={dx:.1f}, dy_stream={dy:.1f}")

    return mover_ocg_directo(pdf_path, nombre_ocg, dx, dy, output_pdf)


# ─────────────────────────────────────────────────────────────
# 4. VERIFICACIÓN (vectorial, sin rasterizar)
# ─────────────────────────────────────────────────────────────

def verificar_posicion_ocg(pdf_path: str, nombre_ocg: str):
    """
    Muestra la posición del OCG en el PDF resultante.
    Usa get_drawings() de PyMuPDF — no rasteriza.
    """
    import tempfile, os

    pdf  = Pdf.open(pdf_path)
    refs = _obtener_refs_ocg(pdf)

    if nombre_ocg not in refs:
        print(f"  OCG '{nombre_ocg}' no encontrado en {pdf_path}")
        pdf.close()
        return

    estados_orig = _leer_estados_originales(pdf)
    _encender_solo(pdf, nombre_ocg)

    with tempfile.NamedTemporaryFile(suffix=".pdf", delete=False) as tmp:
        tmp_path = tmp.name
    pdf.save(tmp_path)
    _restaurar_estados(pdf, estados_orig)
    pdf.close()

    doc   = fitz.open(tmp_path)
    page  = doc[0]
    paths = page.get_drawings()
    doc.close()
    os.unlink(tmp_path)

    print(f"\n  Verificacion '{nombre_ocg}' en {pdf_path}:")
    if paths:
        x0 = min(p["rect"].x0 for p in paths)
        y0 = min(p["rect"].y0 for p in paths)
        x1 = max(p["rect"].x1 for p in paths)
        y1 = max(p["rect"].y1 for p in paths)
        print(f"  BBox  : ({x0:.1f}, {y0:.1f}, {x1:.1f}, {y1:.1f})")
        print(f"  Tamano: {x1-x0:.1f} x {y1-y0:.1f} pts")
    else:
        print("  Sin elementos detectables.")



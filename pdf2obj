        # ─────────────────────────────────────────────────────────────

        t.save(out)

    else:
        # Demo: crea PDF con 3 OCGs independientes y los transforma
        print("Generando demo con 3 OCGs independientes...")
        pdf = Pdf.new()

        ocg1 = pdf.make_indirect(Dictionary(Type=Name("/OCG"), Name="Capa1"))
        ocg2 = pdf.make_indirect(Dictionary(Type=Name("/OCG"), Name="Capa2"))
        ocg3 = pdf.make_indirect(Dictionary(Type=Name("/OCG"), Name="Capa3"))

        pdf.Root["/OCProperties"] = Dictionary(
            OCGs=Array([ocg1, ocg2, ocg3]),
            D=Dictionary(Order=Array([ocg1, ocg2, ocg3])),
        )

        # Tres OCGs al nivel raíz, sin anidamiento
        content = (
            b"/OC /Mc0 BDC\n"
            b"  1 0 0 RG 2 w\n"
            b"  50 50 m 150 50 l 150 150 l 50 150 l h S\n"   # cuadrado rojo
            b"EMC\n"
            b"/OC /Mc1 BDC\n"
            b"  0 0.8 0 RG 2 w\n"
            b"  200 200 m 300 200 l 300 300 l 200 300 l h S\n" # cuadrado verde
            b"EMC\n"
            b"/OC /Mc2 BDC\n"
            b"  0 0 1 RG 2 w\n"
            b"  400 400 m 500 400 l 500 500 l 400 500 l h S\n" # cuadrado azul
            b"EMC\n"
        )

        page_obj = Dictionary(
            Type=Name("/Page"),
            MediaBox=Array([0, 0, 595, 842]),
            Contents=pdf.make_stream(content),
            Resources=Dictionary(
                Properties=Dictionary(Mc0=ocg1, Mc1=ocg2, Mc2=ocg3)
            ),
        )
        pdf.pages.append(pikepdf.Page(page_obj))
        pdf.save("demo_in.pdf")
        print("Creado: demo_in.pdf")

        t = PDFOCGTransformer("demo_in.pdf")
        t.list_ocgs()

        # Cada capa se mueve de forma completamente independiente
        t.translate("Capa1", tx=100, ty=50)        # mover cuadrado rojo
        t.rotate("Capa2", angle_deg=30, cx=250, cy=250)  # rotar cuadrado verde
        t.scale("Capa3", sx=0.5, sy=0.5, cx=450, cy=450) # escalar cuadrado azul

        t.save("demo_out.pdf")
        print("Creado: demo_out.pdf  — verifica que cada capa se movió independientemente")
